    ) -> None:
        """The authored BPTT length reaches the network as one sequence tensor."""
        calls: list[tuple[int, int, bool]] = []
        original_forward = RecurrentTokenQNetwork.forward
    
        def instrumented_forward(self, observations, hidden):
