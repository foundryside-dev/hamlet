+                            batch.dones[rows, t],
+                            online_next,
+                            target_next[:, 0],
+                            batch.next_action_masks[rows, t],
+                            gamma=self.gamma,
+                            double_dqn=self.use_double_dqn,
+                        )
+                    )
+            predictions[rows, :length] = torch.stack(current_predictions, dim=1)
+            targets[rows, :length] = torch.stack(current_targets, dim=1)
