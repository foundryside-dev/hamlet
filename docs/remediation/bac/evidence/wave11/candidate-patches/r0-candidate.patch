+@pytest.mark.parametrize("kind", ["token_set", "recurrent"])
+def test_authored_mean_can_bind_descriptor_value(authored_pair: AuthoredPair, kind: str) -> None:
+    """Normal compiled reset/WAIT observations expose selected binding, without state injection."""
+    pair = authored_pair
+    if kind == "token_set":
+        model = NetworkFactory.build_token_set(pair.config, pair.action_dim, pair.spec)
+    else:
+        model = _factory(kind, pair.spec, "mean", pair.config.token_encoder, pair.action_dim)
+    _set_feature(model.encoder, pair.spec, "interaction_mlp", authored=True)
+    for observation in (pair.first, pair.second):
+        pooled = model.encoder.pooled_embedding(observation)
+        expected = torch.zeros(2, 16)
+        expected[:, 0] = observation[:, pair.right_value_column] / pair.count
+        torch.testing.assert_close(pooled, expected, rtol=0, atol=1e-7)
+    if kind == "token_set":
+        _selected_head(model, pair.wait_id, pair.count, 0.0)
+        first, second = model(pair.first), model(pair.second)
+        assert (first[:, pair.wait_id] > second[:, pair.wait_id]).all()
+        epsilon = model.q_head[1].eps
+        for q, value in ((first, 0.75), (second, 0.25)):
+            mean = (value + 1) / 64
+            variance = (value * value + 1) / 64 - mean * mean
+            expected_q = (value - mean) / math.sqrt(variance + epsilon)
+            torch.testing.assert_close(q[:, pair.wait_id], torch.full((2,), expected_q), rtol=1e-6, atol=1e-6)
+            other = q.clone()
+            other[:, pair.wait_id] = 0
+            assert torch.count_nonzero(other) == 0
