+@pytest.mark.parametrize("kind", ["token_set", "recurrent"])
+@pytest.mark.parametrize("aggregator", ["mean", "attention"])
+@pytest.mark.parametrize("mode", ["linear", "interaction_mlp"])
+def test_semantic_permutation_absence_and_memory(authored_pair: AuthoredPair, kind: str, aggregator: str, mode: str) -> None:
+    """Moving context with rows preserves semantics; absence cuts both MLP layers; memory stays real."""
+    pair = authored_pair
+    declaration = TokenEncoderOptions(mode=mode, hidden_width=1 if mode == "interaction_mlp" else None)
+    model = _factory(kind, pair.spec, aggregator, declaration, pair.action_dim)
+    _set_feature(model.encoder, pair.spec, mode, authored=True)
+    target_spec, permuted = _semantic_permutation(pair.spec, pair.first)
+    target = _factory(kind, target_spec, aggregator, declaration, pair.action_dim)
+    target.load_state_dict(model.state_dict(), strict=True)
+    assert target_spec.get_type("variable_element").slot_context_payloads != pair.spec.get_type("variable_element").slot_context_payloads
+    torch.testing.assert_close(model.encoder(pair.first), target.encoder(permuted), rtol=0, atol=1e-6)
+    if kind == "token_set":
+        torch.testing.assert_close(model(pair.first), target(permuted), rtol=0, atol=1e-6)
+    else:
+        source_q, source_h = model(pair.first[:, None], model.initial_hidden(2, pair.first.device))
+        target_q, target_h = target(permuted[:, None], target.initial_hidden(2, pair.first.device))
+        torch.testing.assert_close(source_q, target_q, rtol=0, atol=1e-6)
+        for source_state, target_state in zip(source_h, target_h, strict=True):
+            torch.testing.assert_close(source_state, target_state, rtol=0, atol=1e-6)
+    keys = model.state_dict()
+    assert not any(marker in key for key in keys for marker in ("_token_context_", "_dynamic_lanes_", "_fixed_lanes_"))
+    if mode == "interaction_mlp":
+        assert not torch.allclose(model.encoder(pair.first), model.encoder(permuted), rtol=0, atol=1e-6)
+    if kind == "recurrent":
+        _memory_controls(model, pair, mode)
+    encoder = model.encoder
+    row = encoder.encoders["variable_element"]
+    with torch.no_grad():
+        for parameter in row.parameters():
+            parameter.fill_(0.25)
+        encoder.type_embeddings["variable_element"].fill_(0.5)
+    _attention_as_mean(encoder)
+    encoder.zero_grad(set_to_none=True)
+    encoder(pair.first).sum().backward()
+    for name, parameter in row.named_parameters():
+        assert parameter.grad is not None and torch.count_nonzero(parameter.grad) > 0, f"vacuous present control: {name}"
+    clean = _absent(pair.first, pair.spec, "variable_element", False)
+    poisoned = _absent(pair.first, pair.spec, "variable_element", True)
+    absent_pool = encoder(poisoned)
+    assert torch.isfinite(absent_pool).all() and torch.count_nonzero(absent_pool) == 0
+    torch.testing.assert_close(encoder(clean), absent_pool, rtol=0, atol=0)
+    encoder.zero_grad(set_to_none=True)
+    encoder(poisoned).sum().backward()
+    _assert_zero_gradients(row.named_parameters())
+    _assert_zero_gradients([("variable type vector", encoder.type_embeddings["variable_element"])])
+    empty = _absent(pair.first, pair.spec, None, True)
+    encoder.zero_grad(set_to_none=True)
+    pooled = encoder(empty)
+    assert torch.isfinite(pooled).all() and torch.count_nonzero(pooled) == 0
+    pooled.sum().backward()
+    _assert_zero_gradients(encoder.named_parameters())
