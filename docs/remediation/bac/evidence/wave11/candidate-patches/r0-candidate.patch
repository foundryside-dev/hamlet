+    target_spec, target_observations = _semantic_permutation(spec, observations)
+    target = _factory(kind, target_spec, "mean", TokenEncoderOptions(mode="interaction_mlp", hidden_width=1), 3)
+    target.load_state_dict(network.state_dict(), strict=True)
