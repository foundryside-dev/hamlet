+@dataclass(frozen=True)
+class AuthoredPair:
+    spec: TokenSpec
+    config: TokenSetConfig
+    first: torch.Tensor
+    second: torch.Tensor
+    action_dim: int
+    wait_id: int
+    count: int
+    right_value_column: int
+
+
+def _presence(spec: TokenSpec, observation: torch.Tensor) -> torch.Tensor:
+    parts = []
+    for layout in spec.compact_layout().types:
+        if layout.capacity:
+            rows = observation[:, layout.start : layout.end].reshape(
+                observation.shape[0], layout.capacity, layout.compact_row_width
+            )
+            parts.append(rows[:, :, layout.dynamic_features.index("presence")] > 0.5)
+    return torch.cat(parts, dim=1)
+
+
+@pytest.fixture(scope="module")
+def authored_pair(tmp_path_factory: pytest.TempPathFactory) -> AuthoredPair:
+    """Compile real DATA, reset at tick 0, then take one publicly legal WAIT."""
+    base = Path(__file__).resolve().parents[4] / "configs" / "test" / "token_set_smoke"
+    pack = tmp_path_factory.mktemp("token_binding") / "pack"
+    shutil.copytree(base, pack)
+    (pack / "variables.yaml").write_text(_VARIABLES)
+    (pack / "levels" / "L0_test" / "bars.yaml").write_text(_BARS)
+    brain_path = pack / "brain.yaml"
+    document = yaml.safe_load(brain_path.read_text())
+    document["architecture"]["token_set"]["token_encoder"] = {"mode": "interaction_mlp", "hidden_width": 1}
+    brain_path.write_text(yaml.safe_dump(document, sort_keys=False))
+    config = load_brain_config(pack).architecture.token_set
+    assert config is not None
+    assert config.token_encoder == TokenEncoderOptions(mode="interaction_mlp", hidden_width=1)
+    universe = UniverseCompiler().compile(pack, primary_level="L0_test", use_cache=False)
+    env = VectorizedHamletEnv.from_universe(universe, level_name="L0_test", num_agents=2, device="cpu")
+    first = env.reset().clone()
+    assert first.is_floating_point() and first.device.type == "cpu"
+    assert first.shape == (2, env.token_spec.total_dims)
+    waits = [action for action in env.level.runtime_action_space.actions if action.name == "WAIT"]
+    assert len(waits) == 1
+    wait_id = waits[0].id
+    assert 0 <= wait_id < env.action_dim
+    masks = env.get_action_masks()
+    assert masks.dtype == torch.bool and masks.shape == (2, env.action_dim)
+    assert masks[:, wait_id].all()
+    actions = torch.full((env.num_agents,), wait_id, dtype=torch.long, device=env.device)
+    second, rewards, dones, info = env.step(actions)
+    second = second.clone()
+    assert second.is_floating_point() and second.device.type == "cpu"
+    assert second.shape == first.shape and rewards.shape == dones.shape == (2,)
+    assert dones.dtype == torch.bool and not dones.any()
+    successor = info["successor_action_masks"]
+    assert successor.dtype == torch.bool and successor.shape == masks.shape
+    torch.testing.assert_close(successor, env.get_action_masks(), rtol=0, atol=0)
+    spec = env.token_spec
+    schema = spec.get_type("variable_element")
