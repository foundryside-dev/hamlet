+    value_columns = []
+    for name, declared in (("pulse_left", 0.125), ("pulse_right", 0.875)):
+        bindings = [binding for binding in schema.slot_bindings if binding.filler_ref == name]
+        assert len(bindings) == 1, (name, schema.slot_bindings)
+        binding = bindings[0]
+        start, end = compact_rows[("variable_element", binding.slot_index)]
+        assert end - start == layout.compact_row_width
+        assert schema.slot_context_payloads[binding.slot_index][schema.payload_features.index("declared_initial")] == declared
+        assert torch.equal(first[:, start], torch.ones(2))
+        assert torch.equal(second[:, start], torch.ones(2))
+        value_columns.append(start + layout.dynamic_features.index("value_0"))
+    left, right = value_columns
+    torch.testing.assert_close(first[:, left], torch.full((2,), 0.25), rtol=0, atol=0)
+    torch.testing.assert_close(first[:, right], torch.full((2,), 0.75), rtol=0, atol=0)
+    torch.testing.assert_close(second[:, left], torch.full((2,), 0.75), rtol=0, atol=0)
