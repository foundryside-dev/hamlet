+@pytest.mark.parametrize("kind", ["token_set", "recurrent"])
+@pytest.mark.parametrize("mode", ["linear", "interaction_mlp"])
+def test_attention_retains_nonuniform_row_interactions(kind: str, mode: str) -> None:
+    """Attention must remain actual content-weighted attention in either encoder family."""
+    spec = _toy_spec()
+    declaration = TokenEncoderOptions(mode=mode, hidden_width=1 if mode == "interaction_mlp" else None)
+    model = _factory(kind, spec, "attention", declaration, 3)
+    encoder = model.encoder
+    assert encoder.aggregator_type == "attention" and encoder.num_heads == 2
+    _set_feature(encoder, spec, mode, authored=False)
+    with torch.no_grad():
+        encoder.q_proj.weight.copy_(torch.eye(16))
+        encoder.k_proj.weight.copy_(torch.eye(16))
+    observation = torch.tensor([[1, 0.25, 0, 1, 0.75, 0]], dtype=torch.float32)
+    values = (0.25, 1.75) if mode == "linear" else (0.0, 0.75)
+    attended = []
+    for query in values:
+        weights = [math.exp(query * key / math.sqrt(8)) for key in values]
+        attended.append(sum(weight * value for weight, value in zip(weights, values, strict=True)) / sum(weights))
+    expected = torch.zeros(1, 16)
+    expected[0, 0] = sum(attended) / 2
+    assert abs(float(expected[0, 0]) - sum(values) / 2) > 1e-5
+    torch.testing.assert_close(encoder(observation), expected, rtol=0, atol=1e-6)
