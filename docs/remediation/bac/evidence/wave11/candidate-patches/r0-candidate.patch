+@pytest.mark.parametrize("kind", ["encoder", "token_set", "recurrent"])
+@pytest.mark.parametrize("aggregator", ["mean", "attention"])
+def test_linear_mean_is_preserved(kind: str, aggregator: str) -> None:
+    """The additive route must preserve old initialization/state and the truthful mean alias."""
+    spec = _toy_spec()
+    model_class = {"encoder": TokenSetEncoder, "token_set": TokenSetQNetwork, "recurrent": RecurrentTokenQNetwork}[kind]
+    arguments = _arguments(kind, spec, aggregator, 3)
+    with torch.random.fork_rng(devices=[]):
+        torch.manual_seed(1701)
+        old = model_class(**arguments)
+        torch.manual_seed(1701)
+        selected = _new_model(kind, spec, aggregator, "linear", None, 3)
+        if kind != "encoder":
+            torch.manual_seed(1701)
+            omitted = _factory(kind, spec, aggregator, None, 3)
+            torch.manual_seed(1701)
+            explicit = _factory(kind, spec, aggregator, TokenEncoderOptions(mode="linear"), 3)
+            for control in (omitted, explicit):
+                assert control.state_dict().keys() == old.state_dict().keys()
+                for key, tensor in old.state_dict().items():
+                    assert torch.equal(tensor, control.state_dict()[key]), key
+    assert selected.state_dict().keys() == old.state_dict().keys()
+    for key, tensor in old.state_dict().items():
+        assert torch.equal(tensor, selected.state_dict()[key]), key
+    omitted_options, origin = resolve_token_encoder(None)
+    assert omitted_options.mode == "linear" and omitted_options.hidden_width is None
+    assert origin == "bac-options-v1: omitted token_encoder retains linear"
+    observations = torch.tensor([[1, 0.25, 0, 1, 0.75, 0], [1, 0.75, 0, 1, 0.25, 0]], dtype=torch.float32)
+    old_encoder, selected_encoder = _encoder(old), _encoder(selected)
+    torch.testing.assert_close(old_encoder(observations), selected_encoder(observations), rtol=0, atol=0)
+    if kind == "token_set":
+        torch.testing.assert_close(old(observations), selected(observations), rtol=0, atol=0)
+    elif kind == "recurrent":
+        sequence = observations.unsqueeze(0)
+        old_q, old_h = old(sequence, old.initial_hidden(1, sequence.device))
+        new_q, new_h = selected(sequence, selected.initial_hidden(1, sequence.device))
+        torch.testing.assert_close(old_q, new_q, rtol=0, atol=0)
+        for first, second in zip(old_h, new_h, strict=True):
+            torch.testing.assert_close(first, second, rtol=0, atol=0)
+    if aggregator == "mean":
+        _set_feature(old_encoder, spec, "linear", authored=False)
+        expected = torch.zeros(2, 16)
+        expected[:, 0] = 1.0
+        torch.testing.assert_close(old_encoder(observations), expected, rtol=0, atol=0)
