+def _toy_spec() -> TokenSpec:
+    features = PAYLOAD_SCHEMAS["variable_element"]
+    contexts = []
+    for declared in (0.0, 1.0):
+        values = {
+            "value_width_used": 0.5, "scope_global": 1.0, "semantic_custom": 1.0,
+            "norm_kind_minmax": 1.0, "norm_param_max": 0.5, "norm_param_clip": 1.0,
+            "norm_param_absent": 1.0, "dtype_float": 1.0, "lifetime_episode": 1.0,
+            "log_element_count": float(torch.tensor(math.log(2) / (1 + math.log(2)), dtype=torch.float32)),
+            "declared_initial": declared,
+        }
+        contexts.append(tuple(values.get(feature, 0.0) for feature in features))
+    schema = build_token_type(
+        "variable_element",
+        (SlotBinding(0, "static", "witness_low", "global"), SlotBinding(1, "static", "witness_high", "global")),
+        slot_context_payloads=contexts, effect_catalog_contexts=(),
+    )
+    return TokenSpec(types=(schema,), position_rank=0, transport_version=TOKEN_TRANSPORT_VERSION)
+
+
+def _arguments(kind: str, spec: TokenSpec, aggregator: str, action_dim: int) -> dict[str, Any]:
+    arguments: dict[str, Any] = {
+        "token_spec": spec, "token_embed_dim": 16, "aggregator_type": aggregator,
+        "num_heads": 2 if aggregator == "attention" else None,
+    }
+    if kind != "encoder":
+        arguments.update(action_dim=action_dim, q_head_hidden_dim=64)
+    if kind == "recurrent":
+        arguments.update(lstm_hidden_size=12, lstm_num_layers=2, lstm_dropout=0.0)
+    return arguments
+
+
+def _new_model(kind: str, spec: TokenSpec, aggregator: str, mode: str, width: int | None, action_dim: int) -> Any:
+    model_class = {"encoder": TokenSetEncoder, "token_set": TokenSetQNetwork, "recurrent": RecurrentTokenQNetwork}[kind]
+    constructor = getattr(model_class, "from_resolved_encoder", None)
+    assert callable(constructor), f"{model_class.__name__} must expose callable from_resolved_encoder for resolved P4 selection"
+    return constructor(
+        **_arguments(kind, spec, aggregator, action_dim),
+        token_encoder_mode=mode, token_encoder_hidden_width=width,
+    )
+
+
+def _factory(kind: str, spec: TokenSpec, aggregator: str, declaration: TokenEncoderOptions | None, action_dim: int) -> Any:
+    aggregate = SetAggregatorConfig(type=aggregator, num_heads=2 if aggregator == "attention" else None)
+    values = dict(token_encoder=declaration, token_embed_dim=16, q_head_hidden_dim=64, aggregator=aggregate)
+    if kind == "token_set":
+        return NetworkFactory.build_token_set(TokenSetConfig(**values), action_dim, spec)
+    config = RecurrentConfig(**values, lstm=LSTMConfig(hidden_size=12, num_layers=2, dropout=0.0))
+    return NetworkFactory.build_recurrent(config, action_dim, spec)
+
+
+def _encoder(model: Any) -> TokenSetEncoder:
+    return model if isinstance(model, TokenSetEncoder) else model.encoder
+
+
+def _row_layers(encoder: TokenSetEncoder, mode: str, width: int | None) -> None:
+    for name, row in encoder.encoders.items():
+        if mode == "linear":
+            assert isinstance(row, nn.Linear), f"linear state/computation changed for {name}"
+        else:
+            assert isinstance(row, nn.Sequential), f"factory ignored interaction_mlp for {name}: {type(row).__name__}"
+            assert len(row) == 3 and isinstance(row[0], nn.Linear) and isinstance(row[1], nn.ReLU)
+            assert isinstance(row[2], nn.Linear) and row[0].out_features == row[2].in_features == width
+
+
+def _attention_as_mean(encoder: TokenSetEncoder) -> None:
+    if encoder.aggregator_type == "attention":
+        with torch.no_grad():
+            for projection in (encoder.q_proj, encoder.k_proj, encoder.v_proj, encoder.out_proj):
+                assert projection is not None
+                projection.weight.zero_()
+                projection.bias.zero_()
+            encoder.v_proj.weight.copy_(torch.eye(encoder.token_embed_dim))
+            encoder.out_proj.weight.copy_(torch.eye(encoder.token_embed_dim))
+
+
+def _set_feature(encoder: TokenSetEncoder, spec: TokenSpec, mode: str, authored: bool) -> None:
+    """Hand-derived joint feature; all unrelated coefficients are explicitly zero."""
+    _row_layers(encoder, mode, 1 if mode == "interaction_mlp" else None)
+    schema = spec.get_type("variable_element")
+    assert schema is not None
+    value = schema.payload_features.index("value_0")
+    descriptor = schema.payload_features.index("declared_initial")
+    with torch.no_grad():
+        for row in encoder.encoders.values():
+            for parameter in row.parameters():
+                parameter.zero_()
+        for vector in encoder.type_embeddings.values():
+            vector.zero_()
+        row = encoder.encoders["variable_element"]
+        if mode == "linear":
+            row.weight[0, value] = row.weight[0, descriptor] = 1.0
+        else:
+            row[0].weight[0, value] = 3.0 if authored else 1.0
+            row[0].weight[0, descriptor] = 4.0 if authored else 1.0
+            row[0].bias[0] = -3.5 if authored else -1.0
+            row[2].weight[0, 0] = 1 / 3 if authored else 1.0
+    _attention_as_mean(encoder)
+
+
+def _selected_head(model: Any, action: int, scale: int, baseline: float) -> None:
+    with torch.no_grad():
+        for parameter in model.q_head.parameters():
+            parameter.zero_()
+        model.q_head[0].weight[0, 0] = scale
+        model.q_head[0].bias[0] = baseline
+        model.q_head[0].bias[1] = 1.0
+        model.q_head[1].weight.fill_(1.0)
+        model.q_head[3].weight[action, 0] = 1.0
+
+
+def _semantic_permutation(spec: TokenSpec, observation: torch.Tensor) -> tuple[TokenSpec, torch.Tensor]:
+    schema = spec.get_type("variable_element")
+    layout = spec.compact_layout().get_type("variable_element")
+    assert schema is not None and layout is not None
+    order = tuple(reversed(range(schema.capacity)))
+    target_schema = replace(
+        schema,
+        slot_bindings=tuple(replace(schema.slot_bindings[old], slot_index=new) for new, old in enumerate(order)),
+        slot_context_payloads=tuple(schema.slot_context_payloads[old] for old in order),
+    )
+    target_spec = replace(spec, types=tuple(target_schema if item.type_name == "variable_element" else item for item in spec.types))
+    rows = observation[:, layout.start : layout.end].reshape(observation.shape[0], schema.capacity, layout.compact_row_width)
+    target = observation.clone()
+    target[:, layout.start : layout.end] = rows[:, order, :].reshape(observation.shape[0], layout.end - layout.start)
+    return target_spec, target
+
+
+def _absent(observation: torch.Tensor, spec: TokenSpec, type_name: str | None, poison: bool) -> torch.Tensor:
+    result = observation.clone()
+    for layout in spec.compact_layout().types:
+        if layout.capacity and (type_name is None or layout.type_name == type_name):
+            rows = result[:, layout.start : layout.end].reshape(result.shape[0], layout.capacity, layout.compact_row_width)
+            rows.zero_()
+            if poison:
+                rows[:, :, 1:] = float("nan")
+    return result
+
+
+def _assert_zero_gradients(parameters: Any) -> None:
+    for name, parameter in parameters:
+        assert parameter.grad is not None, f"missing gradient path: {name}"
+        assert torch.isfinite(parameter.grad).all(), name
+        assert torch.count_nonzero(parameter.grad) == 0, name
+
+
+def _memory_controls(model: RecurrentTokenQNetwork, pair: AuthoredPair, mode: str) -> None:
+    """Select a real recurrent path; compare same current frame after different history."""
+    hidden_size = model.lstm.hidden_size
+    with torch.no_grad():
+        for parameter in model.lstm.parameters():
+            parameter.zero_()
+        # PyTorch LSTM gates are input/forget/candidate/output; activate one candidate per layer.
+        for layer in range(model.lstm.num_layers):
+            getattr(model.lstm, f"weight_ih_l{layer}")[2 * hidden_size, 0] = 1.0
+            getattr(model.lstm, f"weight_hh_l{layer}")[2 * hidden_size, 0] = 0.5
+    _selected_head(model, pair.wait_id, 1, 1.0)
+    sequence = torch.stack((pair.first, pair.second, pair.first), dim=1)
+    initial = model.initial_hidden(2, sequence.device)
+    assert all(item.shape == (2, 2, 12) and torch.count_nonzero(item) == 0 for item in initial)
+    calls = []
+    handle = model.lstm.register_forward_hook(lambda _module, _arguments, _output: calls.append(1))
+    whole, final = model(sequence, initial)
+    handle.remove()
+    assert calls == [1] and whole.shape == (2, 3, pair.action_dim)
+    threaded = model.initial_hidden(2, sequence.device)
+    frames = []
+    for index in range(sequence.shape[1]):
+        frame, threaded = model(sequence[:, index : index + 1], threaded)
+        frames.append(frame)
+    torch.testing.assert_close(whole, torch.cat(frames, dim=1), rtol=0, atol=1e-6)
+    for left, right in zip(final, threaded, strict=True):
+        torch.testing.assert_close(left, right, rtol=0, atol=1e-6)
+    same_current_a = torch.stack((pair.first, pair.first), dim=1)
+    same_current_b = torch.stack((pair.second, pair.first), dim=1)
+    qa, _ = model(same_current_a, model.initial_hidden(2, sequence.device))
+    qb, _ = model(same_current_b, model.initial_hidden(2, sequence.device))
+    if mode == "linear":
+        torch.testing.assert_close(qa[:, -1], qb[:, -1], rtol=0, atol=1e-6)
+    else:
+        assert (qa[:, -1, pair.wait_id] > qb[:, -1, pair.wait_id]).all()
+    model.zero_grad(set_to_none=True)
+    whole, _ = model(sequence, model.initial_hidden(2, sequence.device))
+    whole[:, -1, pair.wait_id].sum().backward()
+    gradient = model.lstm.weight_hh_l0.grad
+    assert gradient is not None and torch.isfinite(gradient).all() and torch.count_nonzero(gradient) > 0
+
+
+@pytest.mark.parametrize("kind", ["encoder", "token_set", "recurrent"])
+@pytest.mark.parametrize("aggregator", ["mean", "attention"])
+@pytest.mark.parametrize("mode,width", [("linear", None), ("interaction_mlp", 3)])
+def test_from_resolved_encoder_requires_explicit_selection(kind: str, aggregator: str, mode: str, width: int | None) -> None:
+    """Missing selection must not silently choose a local policy or hidden width."""
+    spec = _toy_spec()
+    selected, origin = resolve_token_encoder(TokenEncoderOptions(mode=mode, hidden_width=width))
+    assert origin == "authored"
+    model = _new_model(kind, spec, aggregator, selected.mode, selected.hidden_width, 3)
+    encoder = _encoder(model)
+    assert encoder.aggregator_type == aggregator
+    assert encoder.num_heads == (2 if aggregator == "attention" else None)
+    _row_layers(encoder, mode, width)
+    constructor = getattr(type(model), "from_resolved_encoder", None)
+    assert callable(constructor)
+    arguments = _arguments(kind, spec, aggregator, 3)
+    with pytest.raises(TypeError):
+        constructor(**arguments, token_encoder_mode=selected.mode)
+    with pytest.raises(TypeError):
+        constructor(**arguments, token_encoder_hidden_width=selected.hidden_width)
+    for invalid_mode, invalid_width in (("linear", 1), ("interaction_mlp", None), ("interaction_mlp", 0), ("unknown", None)):
+        with pytest.raises((TypeError, ValueError)):
+            constructor(**arguments, token_encoder_mode=invalid_mode, token_encoder_hidden_width=invalid_width)
+    keys = model.state_dict()
+    prefix = "" if kind == "encoder" else "encoder."
+    suffix = "weight" if mode == "linear" else "0.weight"
+    assert f"{prefix}encoders.variable_element.{suffix}" in keys
+    assert not any(marker in key for key in keys for marker in ("_token_context_", "_dynamic_lanes_", "_fixed_lanes_"))
+
+
+@pytest.mark.parametrize("kind", ["token_set", "recurrent"])
+def test_mean_can_bind_descriptor_value(kind: str) -> None:
+    """An affine factory route or an MLP after pooling cannot meet the .375/.125 witness."""
+    spec = _toy_spec()
+    network = _factory(kind, spec, "mean", TokenEncoderOptions(mode="interaction_mlp", hidden_width=1), 3)
+    _set_feature(network.encoder, spec, "interaction_mlp", authored=False)
+    observations = torch.tensor([[1, 0.25, 0, 1, 0.75, 0], [1, 0.75, 0, 1, 0.25, 0]], dtype=torch.float32)
+    pooled = network.encoder.pooled_embedding(observations)
+    expected = torch.zeros(2, 16)
+    expected[:, 0] = torch.tensor([0.375, 0.125])
