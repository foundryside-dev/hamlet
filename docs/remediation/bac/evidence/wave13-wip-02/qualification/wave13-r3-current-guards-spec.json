    {
      "name": "mypy-current",
      "args": [
        "-m",
        "mypy",
        "src/townlet/curriculum/base.py",
        "src/townlet/curriculum/adversarial.py",
        "src/townlet/curriculum/static.py",
        "src/townlet/training/episode.py",
