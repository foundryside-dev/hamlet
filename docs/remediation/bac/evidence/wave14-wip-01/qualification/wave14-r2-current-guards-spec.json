        "src/townlet/config/training_v2_config.py",
        "src/townlet/config/effective_run.py",
        "src/townlet/curriculum/factory.py",
        "tests/test_townlet/regressions/bac/test_curriculum_factory.py",
        "--workers",
        "1"
      ]
    },
    {
      "name": "mypy-current",
      "args": [
        "-m",
        "mypy",
        "src/townlet/config/bac_options.py",
        "src/townlet/config/training_v2_config.py",
        "src/townlet/config/effective_run.py",
        "src/townlet/curriculum/factory.py",
