{
  "root": "/workspace/hamlet",
  "manifest": "/workspace/hamlet/.superpowers/sdd/2026-11-01-bac-remediation-upgrades/wave15/r1-candidate.json",
  "output": "/workspace/bac-review-2026-11-01/qualification/wave15-r1-guards",
  "workers": 2,
  "jobs": [
    {
      "name": "ruff",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ]
    },
    {
      "name": "mypy",
      "args": [
        "-m",
        "mypy",
        "src/townlet"
      ]
    },
    {
      "name": "no-defaults",
      "args": [
        "scripts/no_defaults_lint.py",
        "src/townlet/",
        "--whitelist",
        ".defaults-whitelist.txt",
        "--ratchet",
        ".defaults-ratchet",
        "--quiet"
      ]
    },
    {
      "name": "expression-doc",
      "args": [
        "scripts/gen_expression_functions_doc.py",
        "--check"
      ]
    },
    {
      "name": "black",
      "args": [
        "-m",
        "black",
        "--check",
        "src",
        "tests",
        "scripts",
        "--workers",
        "1"
      ]
    },
    {
      "name": "compiler-cli",
      "args": [
        "scripts/validate_compiler_cli.py"
      ]
    }
  ]
}
