+    assert torch.equal(torch.get_rng_state(), rng)
+    observed = []
+    real_evaluate = env._evaluate_vfs_profiles
+
+    def observe():
+        if env.world_phase != "resetting":
+            return real_evaluate()
+        assert env.world_phase == "resetting"
