+@dataclass
+class LocalProducerOwners:
+    """Local sealed evidence only; no real training or bank state is certified."""
+
+    env: Any
+    authority: Any
+    parent: WorldReceiptIssuer
+    roles: dict[str, WorldReceiptIssuer]
+    roster: WorldRosterDeclaration
