+    equal(target.bank.snapshot_world(world_id="B")["backend"]["rng"], b_before)
+    equal(torch.get_rng_state(), ambient)
+    assert not torch.equal(first, target.bank._owners["A"].call(draw))
+    equal(target.bank.snapshot_world(world_id="B")["backend"]["rng"], b_before)
+
