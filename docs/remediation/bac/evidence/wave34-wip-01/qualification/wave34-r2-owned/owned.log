    @pytest.mark.parametrize("family", FAMILIES)
    @pytest.mark.parametrize("choice", ("fresh_private", "clone_learned_archive_pending"))
    def test_explicit_runtime_private_initialization_preserves_global_cadence(compiled, monkeypatch, family, choice):
        source = _make(compiled, monkeypatch, family, "shared", "paced_fifo")
        source.rig.original = fx.live(source.rig.bank)
        _train(source, monkeypatch, 5 if family == "adaptive_rnd" else 1)
        _commit_parent(source, 70)
        source_live = fx.live(source.rig.bank)
        state = source.runtime.checkpoint_state()
        source.rig.saved = deepcopy(state["bank"])
        target = _make(compiled, monkeypatch, family, "per_world", "paced_fifo")
        parent, validate = target.rig.prepare_parent(source.rig)
        target.parent.cadence = deepcopy(state["cadence"])
        prepared = target.runtime.prepare_private_initialization(
            state=state, initialization=choice, parent_restore=parent, validate_parent_restore=validate
        )
        target.runtime.install_restore(prepared=prepared)
        target.rig.install_parent()
        saved = target.runtime.checkpoint_state()
        assert saved["bank"]["bank_phase"] == "private_initialized"
        assert saved["bank"]["curiosity_epoch"] == state["bank"]["curiosity_epoch"] + 1
        origin = saved["bank"]["initialization_origin"]
        assert origin["initialization"] == choice
        fx.equal(origin["source_checkpoint"], state["bank"])
        fx.equal(saved["selector"], state["selector"])
        fx.equal(saved["cadence"], state["cadence"])
        for world in fx.IDS:
            snapshot = target.runtime.snapshot_world(world_id=world)
            fx.assert_future(snapshot, family, 0, 0)
