+    before = fx.live(case.rig.bank)
+    retried = case.runtime.reward(context=context, stamp=stamp, accepted=case.rig.accepted, update_stats=True)
+    fx.equal(retried.raw, reward.raw)
+    fx.equal(retried.scales, reward.scales)
+    fx.equal(case.runtime.admit_and_service(context=context, stamp=stamp, accepted=case.rig.accepted), receipts)
+    fx.equal(fx.live(case.rig.bank), before)
+    assert case.runtime.epsilon == epsilon
+    if scope == "per_world":
+        fx.equal(fx.live(case.rig.bank, "B"), untouched)
+    reward.scales.zero_()
+    fx.equal(case.runtime.reward(context=context, stamp=stamp, accepted=case.rig.accepted, update_stats=True).scales, retried.scales)
+    with pytest.raises(REFUSAL):
+        case.runtime.reward(context=context, stamp=stamp, accepted=case.rig.accepted, update_stats=False)
