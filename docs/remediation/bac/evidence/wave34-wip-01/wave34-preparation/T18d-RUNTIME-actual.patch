+@pytest.mark.parametrize("scope", SCOPES)
+def test_selection_uses_owned_training_tensor_and_real_masks(compiled, monkeypatch, scope):
+    case = _make(compiled, monkeypatch, "none", scope, "paced_fifo")
+    real_select = EpsilonGreedyExploration.select_actions
+    observed = []
+
+    def capture(selector, q_values, agent_states, action_masks):
+        observed.append((agent_states, agent_states.epsilons.clone()))
+        return real_select(selector, q_values, agent_states, action_masks)
+
+    monkeypatch.setattr(EpsilonGreedyExploration, "select_actions", capture)
+    state = _state(2)
+    original = state.epsilons
+    q_values = torch.tensor([[100.0, -100.0], [-100.0, 100.0]])
+    masks = torch.tensor([[False, True], [True, False]])
+    actions = case.runtime.select_actions(q_values, state, action_masks=masks)
+    assert actions.dtype == torch.int64 and actions.tolist() == [1, 0]
+    assert len(observed) == 1 and observed[0][0] is not state
+    fx.equal(observed[0][1], torch.full((2,), case.selected.epsilon_start, dtype=torch.float32))
+    assert state.epsilons is original and state.epsilons.tolist() == pytest.approx([0.123, 0.123])
+    tensor = case.runtime.epsilon_tensor(batch_size=2, device=torch.device("cpu"))
+    tensor.zero_()
+    assert case.runtime.epsilon == case.selected.epsilon_start
+    assert torch.all(case.runtime.epsilon_tensor(batch_size=2, device="cpu") == case.runtime.epsilon)
+    case.runtime.select_actions(q_values, state, action_masks=None)
+    rng = torch.get_rng_state().clone()
+    empty = case.runtime.select_actions(torch.empty(0, 2), _state(0), action_masks=None)
+    assert empty.shape == (0,) and empty.dtype == torch.int64
+    fx.equal(torch.get_rng_state(), rng)
+    with pytest.raises(TypeError):
+        case.runtime.select_actions(q_values, state)
+
+    _train(case, monkeypatch, 1)
+    _commit_parent(case, 100)
+    current = max(case.selected.epsilon_end, case.selected.epsilon_start * case.selected.epsilon_decay)
+    assert current != case.selected.epsilon_start and case.runtime.epsilon == current
+    count = len(observed)
+    assert case.runtime.select_actions(q_values, state, action_masks=masks).tolist() == [1, 0]
+    assert len(observed) == count + 1
+    fx.equal(observed[-1][1], torch.full((2,), current, dtype=torch.float32))
+    assert state.epsilons is original and state.epsilons.tolist() == pytest.approx([0.123, 0.123])
+
+    saved = case.runtime.checkpoint_state()
+    receiver = _make(compiled, monkeypatch, "none", scope, "paced_fifo")
+    receiver.runtime.install_restore(prepared=_completed_prepare(receiver, case, saved))
+    receiver.rig.install_parent()
+    count = len(observed)
+    assert receiver.runtime.select_actions(q_values, state, action_masks=masks).tolist() == [1, 0]
+    assert len(observed) == count + 1 and observed[-1][0] is not state
