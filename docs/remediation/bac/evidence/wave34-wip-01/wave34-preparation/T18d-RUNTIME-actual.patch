+@pytest.mark.parametrize("label", ("uniform", "per", "sequence-trained"))
+def test_protected_historical_artifact_archive_query_export(label, tmp_path):
+    """Actual read-only history, not full native admission via a fake validator."""
+    payload, path, digest = _historical(label)
+    original = deepcopy(payload)
+    policy = hc.resolve_historical_access(payload, requested_mode="auto")
+    assert policy.effective_mode == "archived_history_fresh_episode"
+    assert policy.active_retained_transitions == 0
+    assert policy.approval_reference == "BAC-HISTORY-A-2026-11-01"
+    assert "source provider was AdaptiveIntrinsicExploration" in policy.guarantees
+    with pytest.raises(hc.HistoricalLegalityUnavailable):
+        hc.resolve_historical_access(payload, requested_mode="recorded_full_resume")
+    replay = payload["population_state"]["replay_buffer"]
+    archive = hc.archive_standalone_replay(replay)
+    assert archive.archived_row_count == policy.archived_row_count > 0
+    assert archive.reward_semantics == "historical_recorded_pre_fix"
+    assert archive.source_formats["scope"] == "standalone_replay"
+    fx.equal(archive.original_state, replay)
+    rows = archive.query_rows(offset=0, limit=archive.archived_row_count)
+    episodes = replay["episodes"] if replay["replay_kind"] == "sequential" else [replay]
+    for field in ("observations", "actions", "rewards", "next_observations", "dones"):
+        fx.equal(rows[field], torch.cat([episode[field] for episode in episodes]))
+    for field in ("rewards_extrinsic", "rewards_intrinsic", "rewards_shaping"):
+        present = torch.cat([torch.full_like(episode["dones"], episode[field] is not None, dtype=torch.bool) for episode in episodes])
+        fx.equal(rows[f"{field}_present"], present)
+        if present.any():
+            values = torch.cat([torch.zeros_like(episode["rewards"]) if episode[field] is None else episode[field] for episode in episodes])
+            fx.equal(rows[field][present], values[present])
+        else:
+            assert field not in rows
+    assert "next_action_masks" not in rows and "legality_recorded" not in rows
+    rows["rewards"].add_(123)
+    fx.equal(archive.original_state, replay)
+    destination = tmp_path / f"{label}-archive.pt"
+    receipt = archive.export(destination)
+    assert receipt.row_count == archive.archived_row_count
+    assert receipt.source_digest == archive.source_digest
+    assert receipt.output_digest == "artifact-sha256:" + hashlib.sha256(destination.read_bytes()).hexdigest()
+    exported = checkpoint_io.safe_torch_load(destination, map_location="cpu", allow_unsafe_pickle=True)
+    fx.equal(exported, replay)
+    with pytest.raises(FileExistsError):
+        archive.export(destination)
+    fx.equal(payload, original)
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == digest
