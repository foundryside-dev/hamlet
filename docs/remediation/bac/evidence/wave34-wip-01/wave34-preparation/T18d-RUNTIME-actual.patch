+class GuardPreworkReachedError(AssertionError):
+    """Outside REFUSAL: an ordinary child/preflight rejection cannot hide this."""
+
+
+class UnreadGuardState(dict):
+    """Require operation-entry refusal before even owning/inspecting input."""
+
+    def _reject(self, *args, **kwargs):
+        raise GuardPreworkReachedError("runtime inspected state before rejecting reentry")
+
+    __getitem__ = _reject
+    __iter__ = _reject
+    __len__ = _reject
+    __deepcopy__ = _reject
+    keys = _reject
+    items = _reject
+    values = _reject
+    get = _reject
+
+
+@pytest.mark.parametrize(
+    "operation",
+    (
+        "begin",
+        "stamp",
+        "reward",
+        "service",
+        "prepare_completion",
+        "commit_completion",
+        "empty",
+        "quarantine",
+        "prepare_restore",
+        "install",
+        "initialize",
+    ),
+)
+def test_guard_covers_all_bank_forwarding_entries(compiled, monkeypatch, operation):
+    case = _make(compiled, monkeypatch, "none", "per_world", "paced_fifo")
+    _begin(case, 0)
+    context, stamp, _, _ = _step(case, monkeypatch, 0, (True, False))
+    _close(case, monkeypatch)
+    outcomes = _parent_outcomes(case, 100)
+    case.parent.record(100, outcomes)
+    bank_outcomes, bank_token = case.completions[-1]
+    arguments = dict(context=context, stamp=stamp, accepted=case.rig.accepted)
+    saved = case.runtime.checkpoint_state()
+    unread = UnreadGuardState(saved)
+    # Some arguments are intentionally inapplicable after completion. Neither
+    # ordinary preflight refusal nor a child refusal is accepted as guard proof:
+    # require the distinct guard error and fail outside REFUSAL on any prework.
+    actions = {
+        "begin": lambda: case.runtime.begin_episode(accepted=case.rig.accepted),
+        "stamp": lambda: case.runtime.prepare_step_stamp(
+            accepted=case.rig.accepted,
+            world_ids=case.rig.accepted.world_ids,
+            active_on_entry=context.active_on_entry,
+            vector_tick=context.vector_tick,
+        ),
+        "reward": lambda: case.runtime.reward(**arguments, update_stats=True),
+        "service": lambda: case.runtime.admit_and_service(**arguments),
+        "prepare_completion": lambda: case.runtime.prepare_completion(
+            accepted=case.rig.accepted,
+            boundary_key=case.rig.accepted.batch_episode,
+            completion_content=_content(bank_outcomes),
+            outcomes=bank_outcomes,
+            participated_world_ids=tuple(event.world_id for event in bank_outcomes),
+        ),
+        "commit_completion": lambda: case.runtime.commit_completion(prepared=bank_token),
+        "empty": lambda: case.runtime.prepare_empty_episode_evidence(accepted=case.rig.accepted),
+        "quarantine": lambda: case.runtime.quarantine_episode(accepted=case.rig.accepted, reason="runtime_failure"),
+        "prepare_restore": lambda: case.runtime.prepare_restore(
+            state=unread, mode="initial", accepted=None, parent_restore=None, validate_parent_restore=None
+        ),
+        "install": lambda: case.runtime.install_restore(prepared=object()),
+        "initialize": lambda: case.runtime.prepare_private_initialization(
+            state=unread, initialization="fresh_private", parent_restore=None, validate_parent_restore=None
+        ),
+    }
+    revision = case.rig.bank.mutation_revision
+    reports = len(case.rig.reports)
+    rng = torch.get_rng_state().clone()
+    restores = len(case.parent.restore_calls)
+    reached = []
+
+    def child_prework(*args, **kwargs):
+        reached.append(operation)
+        raise GuardPreworkReachedError("runtime dispatched to BANK before rejecting reentry")
+
+    boundary = {
+        "begin": "begin_episode",
+        "stamp": "prepare_step_stamp",
+        "reward": "reward",
+        "service": "admit_and_service",
+        "prepare_completion": "prepare_completion",
+        "commit_completion": "commit_completion",
+        "empty": "prepare_empty_episode_evidence",
+        "quarantine": "quarantine_episode",
+        "prepare_restore": "prepare_restore",
+        "install": "install_restore",
+        "initialize": "prepare_private_initialization",
+    }
+    case.parent.commit_action = actions[operation]
+    with monkeypatch.context() as patch:
+        patch.setattr(case.rig.bank, boundary[operation], child_prework)
+        with pytest.raises(RuntimeError, match="reentrant runtime operation"):
+            case.runtime.commit_batch_episode(batch_episode=100, outcomes=outcomes)
+    assert not reached
+    assert case.rig.bank.mutation_revision == revision
+    assert len(case.rig.reports) == reports
+    assert len(case.parent.restore_calls) == restores
+    fx.equal(torch.get_rng_state(), rng)
+    fx.equal(case.runtime.checkpoint_state(), saved)
+    case.parent.commit_action = None
+    case.runtime.commit_batch_episode(batch_episode=100, outcomes=outcomes)
+
