+    context, stamp, reward, receipts = _step(case, monkeypatch, 0, (True, False))
+    epsilon = case.runtime.epsilon
+    assert reward.raw.shape == reward.scales.shape == (2,)
+    assert reward.eligible.tolist() == [True, False]
+    assert reward.raw[1] == reward.scales[1] == 0
+    expected = 0.0 if family == "none" else 0.4
+    if family == "adaptive_rnd":
+        expected = fx.on_backend(case.rig.bank, lambda provider: provider.get_intrinsic_weight())
+    assert float(reward.scales[0]) == pytest.approx(expected)
+    if family == "none":
