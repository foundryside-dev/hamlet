+def _historical(label):
+    directory = FIXTURES / "bac_historical"
+    manifest = json.loads((directory / "portable-manifest.json").read_text())
+    record = next(item for item in manifest["canonical_artifacts"] if item["label"] == label)
+    path = directory / record["artifact"]
+    payload = _load_protected(path, record["sha256"])
+    assert payload["version"] == record["demo_version"] == 9
+    assert payload["population_state"]["version"] == record["population_version"] == 6
+    assert list(payload) == record["outer_keys"]
+    assert list(payload["population_state"]) == record["population_keys"]
+    return payload, path, record["sha256"]
