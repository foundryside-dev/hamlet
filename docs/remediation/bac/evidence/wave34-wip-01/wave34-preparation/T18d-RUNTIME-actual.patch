+        old_counters, tail = fx.native_ledger(before["native"], family)
+        new_counters, pending = fx.native_ledger(after["native"], family)
+        assert len(tail) == 1 and len(pending) == 0
+        assert new_counters["optimizer_updates"] == old_counters["optimizer_updates"] + 1
+        assert observed
+        with pytest.raises(AssertionError):
+            fx.equal(fx.learned(after["native"], family), fx.learned(before["native"], family))
+    elif family == "count_based":
+        with pytest.raises(AssertionError):
+            fx.equal(after["native"], before["native"])
+    else:
+        fx.equal(after["native"], before["native"])
+    fx.equal(fx.live(source.rig.bank), source_live)
+    fx.equal(source.runtime.checkpoint_state(), saved)
