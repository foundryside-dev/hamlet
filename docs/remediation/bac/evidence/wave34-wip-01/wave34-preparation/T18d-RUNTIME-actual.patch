+def test_actual_current_replay_preserved_in_explicit_hc_component_wrapper(directory, filename, manifest_key):
+    folder = FIXTURES / directory
+    manifest = json.loads((folder / "portable-manifest.json").read_text())
+    digest = manifest[manifest_key][filename]["sha256"]
+    path = folder / filename
+    replay = _load_protected(path, digest)
+    original = deepcopy(replay)
+    episodes = replay["episodes"] if replay["replay_kind"] == "sequential" else [replay]
+    masks = episodes[0]["next_action_masks"]
+    # Explicit HC component transport around genuine replay capture. These
+    # metadata are NOT represented as a genuine native demo/population artifact.
+    component = {
+        "version": 10,
+        "action_dim": masks.shape[1],
+        "population_state": {"version": 7, "replay_buffer": replay},
+        "historical_archives": deepcopy(replay["historical_archives"]),
+    }
+
+    def must_not_be_called(owned):
+        pytest.fail("current captured replay dispatched to historical native validator")
+
+    envelope = hc.prepare_historical_envelope(component, requested_mode="auto", validate_legacy=must_not_be_called)
+    assert envelope.policy.effective_mode == "recorded_full_resume"
+    assert envelope.policy.active_retained_transitions == 3
+    assert len(envelope.archives) == len(replay["historical_archives"])
+    fx.equal(envelope.available_learned_state["population_state"]["replay_buffer"], original)
+    encoded = hc.encode_historical_envelope(envelope)
+    decoded = hc.decode_historical_envelope(encoded)
+    fx.equal(decoded.available_learned_state, envelope.available_learned_state)
+    assert decoded.policy.archived_row_count == sum(item.archived_row_count for item in envelope.archives)
+    with pytest.raises(ValueError):
+        hc.resolve_historical_access(component, requested_mode="archived_history_fresh_episode")
+    encoded["available_learned_state"]["population_state"]["replay_buffer"]["capacity"] = 999
+    fx.equal(decoded.available_learned_state["population_state"]["replay_buffer"], original)
+    fx.equal(replay, original)
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == digest
