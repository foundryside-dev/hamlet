+"""Original T18d runtime consumers; cooperative parent seams are not POP integration.
+
+Only the documented PW07 fixture API is reused. Runtime lookup is deliberately
+inside _make: prerequisite controls collect/run before the missing entry RED.
+"""
+
+import hashlib
+import json
+from contextlib import contextmanager
+from copy import copy, deepcopy
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+import torch
+
+from tests.test_townlet.regressions.bac import test_pw_scope_conversion as fx
+from tests.test_townlet.regressions.bac.test_pw_scope_conversion import compiled as compiled
+from townlet.config import exploration_policy as rp
+from townlet.exploration.epsilon_greedy import EpsilonGreedyExploration
+from townlet.training import checkpoint_utils as checkpoint_io
+from townlet.training import historical_checkpoint as hc
+from townlet.training.episode import freeze_lane_outcome
+from townlet.training.state import BatchedAgentState
+
+FAMILIES = ("none", "count_based", "rnd", "adaptive_rnd", "icm")
+SCOPES = ("shared", "per_world")
+TRAINABLE = ("rnd", "adaptive_rnd", "icm")
+CLASSES = {
+    "none": "EpsilonGreedyExploration",
+    "count_based": "CountExploration",
+    "rnd": "RNDExploration",
+    "adaptive_rnd": "AdaptiveIntrinsicExploration",
+    "icm": "ICMExploration",
+}
+REFUSAL = (ValueError, RuntimeError, TypeError)
+
+
+def _content(outcomes):
+    return tuple((value.payload.hex(), value.fingerprint) for value in map(freeze_lane_outcome, outcomes))
+
+
+class CooperativeParent:
+    """Explicit component authenticator; no claim of actual POP commit authority."""
+
+    def __init__(self):
+        self.committed = {}
+        self.calls = []
+        self.restore_calls = []
+        self.cadence = {"schema": "parent-global-epsilon-cadence-v1", "last_committed": None}
+        self.commit_action = None
+        self.restore_action = None
+        self.reject = False
+        self.restore_return = None
+        self.mutate_restore = False
+
+    def record(self, batch_episode, outcomes):
+        assert type(batch_episode) is int and all(event.batch_episode == batch_episode for event in outcomes)
+        self.committed[batch_episode] = _content(outcomes)
+
+    def validate_committed_batch(self, *, batch_episode, outcomes):
+        self.calls.append(batch_episode)
+        if self.commit_action is not None:
+            self.commit_action()
+        if self.reject:
+            raise ValueError("cooperative parent has not committed")
+        assert batch_episode in self.committed
+        fx.equal(_content(outcomes), self.committed[batch_episode])
+        return None
+
+    def validate_parent_cadence(self, *, cadence, mode, accepted, parent_restore):
+        self.restore_calls.append((mode, accepted, parent_restore))
+        if self.restore_action is not None:
+            self.restore_action()
+        fx.equal(cadence, self.cadence)
+        if self.mutate_restore:
+            cadence["schema"] = "callback changed owned view"
+        return self.restore_return
+
+
+class AcceptedGate:
+    """Always invokes the genuine ENV validator; hook only exercises reentry."""
+
+    def __init__(self, authenticate):
+        self.authenticate = authenticate
+        self.action = None
+        self.catch = False
+        self.refusals = 0
+
+    def __call__(self, *, accepted):
+        self.authenticate(accepted=accepted)
+        if self.action is not None:
+            if self.catch:
+                try:
+                    self.action()
+                except REFUSAL:
+                    self.refusals += 1
+                else:
+                    pytest.fail("reentrant public operation was allowed")
+            else:
+                self.action()
+        return None
+
+
+class RuntimeRig:
+    def __init__(self, rig, runtime, parent, gate, selected):
+        self.rig, self.runtime, self.parent, self.gate, self.selected = rig, runtime, parent, gate, selected
+        self.completions = []
+
+
+def _make(compiled, monkeypatch, family, scope, mode):
+    selected = fx.policy(compiled, family, scope, mode)
+    parent = CooperativeParent()
+    captured = {}
+
+    def construct(*, policy, descriptor, device, validate_accepted_episode, issuer_factory, report_allocation):
+        owners = []
+        gate = AcceptedGate(validate_accepted_episode)
+
+        def issue(owner):
+            owners.append(owner)
+            return issuer_factory(owner)
+
+        # This is the intended causal missing-operation failure, not collection.
+        runtime = rp.build_exploration(
+            policy=policy,
+            descriptor=descriptor,
+            device=device,
+            validate_accepted_episode=gate,
+            issuer_factory=issue,
+            report_allocation=report_allocation,
+            validate_committed_batch=parent.validate_committed_batch,
+            validate_parent_cadence=parent.validate_parent_cadence,
+        )
+        assert isinstance(runtime, rp.ExplorationRuntime)
+        assert len(owners) == 1
+        captured.update(runtime=runtime, owner=owners[0], gate=gate)
+        return owners[0]
+
+    with monkeypatch.context() as patch:
+        patch.setattr(fx, "CuriosityBank", construct)
+        rig = fx.Rig(compiled, selected)
+    assert captured["owner"] is rig.bank
+    return RuntimeRig(rig, captured["runtime"], parent, captured["gate"], selected)
+
+
+def _begin(case, batch):
+    case.rig.begin(batch)
+    # Rig supplied actual reset/activation. Exercise the facade's accepted retry.
+    receipt = case.runtime.begin_episode(accepted=case.rig.accepted)
+    assert receipt is case.runtime.begin_episode(accepted=case.rig.accepted)
+
+
+def _step(case, monkeypatch, tick, active):
+    service = fx.service
+
+    def through_runtime(bank, accepted, tick, active):
+        assert bank is case.rig.bank and accepted is case.rig.accepted
+        # Existing helper calls precisely the three approved runtime public APIs.
+        return service(case.runtime, accepted, tick, active)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(fx, "service", through_runtime)
+        return case.rig.step(tick, active)
+
+
+@contextmanager
+def _completion_route(case, monkeypatch):
+    bank = case.rig.bank
+    prepare, commit = bank.prepare_completion, bank.commit_completion
+
+    def routed_prepare(*, accepted, boundary_key, completion_content, outcomes, participated_world_ids):
+        arguments = dict(
+            accepted=accepted,
+            boundary_key=boundary_key,
+            completion_content=completion_content,
+            outcomes=outcomes,
+            participated_world_ids=participated_world_ids,
+        )
+        with monkeypatch.context() as inner:
+            inner.setattr(bank, "prepare_completion", prepare)
+            token = case.runtime.prepare_completion(**arguments)
+            assert case.runtime.prepare_completion(**arguments) is token
+        case.completions.append((deepcopy(outcomes), token))
+        return token
+
+    def routed_commit(*, prepared):
+        with monkeypatch.context() as inner:
+            inner.setattr(bank, "commit_completion", commit)
+            receipt = case.runtime.commit_completion(prepared=prepared)
+            before = fx.live(bank)
+            assert case.runtime.commit_completion(prepared=prepared) is receipt
+            fx.equal(fx.live(bank), before)
+        return receipt
+
+    with monkeypatch.context() as patch:
+        patch.setattr(bank, "prepare_completion", routed_prepare)
+        patch.setattr(bank, "commit_completion", routed_commit)
+        yield
+
+
+def _close(case, monkeypatch):
+    epsilon = case.runtime.epsilon
+    with _completion_route(case, monkeypatch):
+        case.rig.close()
+    assert case.runtime.epsilon == epsilon
+    return case.completions[-1][0]
+
+
+def _parent_outcomes(case, parent_batch):
+    # Plain owned outcome data in a deliberately distinct cooperative parent
+    # domain. It is not an ENV token and is never passed to BANK completion.
+    return tuple(replace(event, batch_episode=parent_batch) for event in case.completions[-1][0])
+
+
+def _commit_parent(case, parent_batch):
+    outcomes = _parent_outcomes(case, parent_batch)
+    case.parent.record(parent_batch, outcomes)
+    case.runtime.commit_batch_episode(batch_episode=parent_batch, outcomes=outcomes)
+    return outcomes
+
+
+def _state(rows):
+    return BatchedAgentState(
+        observations=torch.ones(rows, 3),
+        actions=torch.zeros(rows, dtype=torch.int64),
+        rewards=torch.zeros(rows),
+        dones=torch.zeros(rows, dtype=torch.bool),
+        epsilons=torch.full((rows,), 0.123),
+        intrinsic_rewards=torch.zeros(rows),
+        survival_times=torch.zeros(rows),
+        device=torch.device("cpu"),
+        info={"owned_by": "parent"},
+    )
+
+
+def _live_prepare(target, saved):
+    target.parent.cadence = deepcopy(saved["cadence"])
+    return target.runtime.prepare_restore(
+        state=saved,
+        mode="live_episode",
+        accepted=target.rig.accepted,
+        parent_restore=None,
+        validate_parent_restore=None,
+    )
+
+
+def _completed_prepare(target, source, saved):
+    parent, validate = target.rig.prepare_parent(source.rig)
+    target.parent.cadence = deepcopy(saved["cadence"])
+    return target.runtime.prepare_restore(
+        state=saved,
+        mode="completed_boundary",
+        accepted=None,
+        parent_restore=parent,
+        validate_parent_restore=validate,
+    )
+
+
+def _initial_prepare(target, saved):
+    target.parent.cadence = deepcopy(saved["cadence"])
+    return target.runtime.prepare_restore(state=saved, mode="initial", accepted=None, parent_restore=None, validate_parent_restore=None)
+
+
+def _train(case, monkeypatch, episodes):
+    for episode in range(episodes):
+        _begin(case, episode)
+        for tick in range(5):
+            _step(case, monkeypatch, episode * 5 + tick, (True, False))
+        _close(case, monkeypatch)
+    fx.set_gradients(case.rig.bank)
+
+
+@pytest.mark.parametrize("family", FAMILIES)
+@pytest.mark.parametrize("scope", SCOPES)
+def test_runtime_fixture_prerequisite(compiled, family, scope):
+    """Genuine controls do not look up any new RP name."""
+    rig = fx.Rig(compiled, fx.policy(compiled, family, scope, "paced_fifo"))
+    rig.begin(0)
+    for tick in range(3):
+        context, stamp, reward, receipts = rig.step(tick, (True, False))
+    assert rig.accepted is not None and receipts
+    fx.equal(reward.raw, rig.bank.reward(context=context, stamp=stamp, accepted=rig.accepted, update_stats=True).raw)
+    rig.close()
+    state = rig.bank.checkpoint_state()
+    assert state["bank_phase"] == "completed_boundary"
+    assert state["policy"]["strategy"] == family
+    witness = fx.live(rig.bank)
+    if family in TRAINABLE:
+        counters, pending = fx.native_ledger(witness["native"], family)
+        assert counters["optimizer_updates"] >= 1
+        assert len(pending) == 1
+    if family == "none":
+        assert torch.count_nonzero(reward.raw) == torch.count_nonzero(reward.scales) == 0
+
