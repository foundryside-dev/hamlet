+@pytest.mark.parametrize("scope", SCOPES)
+@pytest.mark.parametrize("damage", ("selector_vs_after", "after_vs_recurrence", "no_record_nonstart"))
+def test_committed_cadence_local_correlation_refusal(compiled, monkeypatch, scope, damage):
+    source = _make(compiled, monkeypatch, "rnd", scope, "paced_fifo")
+    target = _make(compiled, monkeypatch, "rnd", scope, "paced_fifo")
+    _train(source, monkeypatch, 1)
+    _commit_parent(source, 100)
+    saved = source.runtime.checkpoint_state()
+    corrupt = deepcopy(saved)
+    record = corrupt["cadence"]["last_committed"]
+    start, end, decay = source.selected.epsilon_start, source.selected.epsilon_end, source.selected.epsilon_decay
+    correct = max(end, record["epsilon_before"] * decay)
+    assert correct == record["epsilon_after"] == saved["selector"]["epsilon"] and correct < start
+    different = (correct + start) / 2
+    assert end <= different <= start and different != correct
+    if damage == "selector_vs_after":
+        corrupt["selector"]["epsilon"] = different
+    elif damage == "after_vs_recurrence":
+        record["epsilon_after"] = corrupt["selector"]["epsilon"] = different
+    else:
+        corrupt["cadence"]["last_committed"] = None
+        assert corrupt["selector"]["epsilon"] != start
+
+    parent, validate = target.rig.prepare_parent(source.rig)
+    target.parent.cadence = deepcopy(corrupt["cadence"])
+    # Prove the independent cooperative parent approves this exact candidate;
+    # rejection must come from local selector/cadence validation, not its equality.
+    target.parent.validate_parent_cadence(
+        cadence=deepcopy(corrupt["cadence"]), mode="completed_boundary", accepted=None, parent_restore=parent
+    )
+    before = target.runtime.checkpoint_state()
+    live = fx.live(target.rig.bank)
+    rng = torch.get_rng_state().clone()
+    with pytest.raises(REFUSAL):
+        target.runtime.prepare_restore(
+            state=corrupt,
+            mode="completed_boundary",
+            accepted=None,
+            parent_restore=parent,
+            validate_parent_restore=validate,
+        )
+    fx.equal(target.runtime.checkpoint_state(), before)
+    fx.equal(fx.live(target.rig.bank), live)
+    fx.equal(torch.get_rng_state(), rng)
+    target.parent.cadence = deepcopy(saved["cadence"])
+    prepared = target.runtime.prepare_restore(
+        state=saved, mode="completed_boundary", accepted=None, parent_restore=parent, validate_parent_restore=validate
+    )
+    target.runtime.install_restore(prepared=prepared)
+    target.rig.install_parent()
+    fx.equal(target.runtime.checkpoint_state(), saved)
+
+
