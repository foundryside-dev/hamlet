+class GuardPreworkReachedError(AssertionError):
+    """Outside REFUSAL: an ordinary child/preflight rejection cannot hide this."""
+
+
+class UnreadGuardState(dict):
+    """Require operation-entry refusal before even owning/inspecting input."""
+
+    def _reject(self, *args, **kwargs):
+        raise GuardPreworkReachedError("runtime inspected state before rejecting reentry")
+
+    __getitem__ = _reject
+    __iter__ = _reject
+    __len__ = _reject
+    __deepcopy__ = _reject
+    keys = _reject
+    items = _reject
+    values = _reject
+    get = _reject
+
