                                    "expression": "0.0",
                                    "composition": "overwrite",
                                    "condition": None,
                                    "clamp": None,
                                    "effect": None,
                                }
                            ],
                        }
                    ],
                },
            )
        universe = UniverseCompiler().compile(pack, primary_level="L0", use_cache=False)
