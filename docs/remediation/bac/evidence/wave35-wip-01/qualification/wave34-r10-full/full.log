        def brain_edit(data):
            data["q_learning"].update(gamma=gamma, use_double_dqn=double, target_update_frequency=1000)
            data["loss"] = {"type": "huber", "huber_delta": 0.25}
            data["replay"] = {"capacity": capacity, "prioritized": per}
