            t["exploration"].update(epsilon_start=0.0, epsilon_end=0.0, epsilon_decay=0.99)
            t["enabled_actions"]["custom"] = ["WAIT"] if global_illegal else ["WAIT", "REST", "MEDITATE"]
            t["bac_options"] = {"replay": options.model_dump()}
    
        def drive_edit(data):
            d = data["drive"]
