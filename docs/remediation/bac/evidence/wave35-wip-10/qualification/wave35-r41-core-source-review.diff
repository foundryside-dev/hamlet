+        owner.call(lambda backend, sources: backend.optimizer.step())  # genuine retained backward gradients
+    elif mutation == "replacement":
+
+        def replace(backend: RNDExploration, sources: WorldRandomSources) -> None:
+            backend.optimizer = torch.optim.Adam(backend.predictor_network.parameters(), lr=0.001)
+
+        owner.call(replace)
+    elif mutation == "ambient":
+        shared.call(lambda backend: None)  # unchanged RNG bytes still invalidate domain freshness
+    elif mutation == "membership":
+        member = process_rng_domain().register(owner=object(), cuda_devices=(), entrypoints=frozenset({"probe"}))
+        process_rng_domain().unregister(participant=member)
+    elif mutation == "fabricated":
