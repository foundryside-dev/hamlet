+MALFORMED = (
+    "missing_recipe",
+    "old_schema",
+    "wrong_algorithm",
+    "wrong_version",
+    "bool_version",
+    "extra_recipe_key",
+    "extra_group_key",
+    "missing_name",
+    "duplicate_name",
+    "foreign_name",
+    "name_type",
+    "names_tuple",
+    "duplicate_id",
+    "omitted_id",
+    "id_type",
+    "group_count",
+    "name_order",
+    "options_value",
+    "options_type",
+    "options_keys",
+    "payload_config_only",
+    "payload_option_type",
+    "wrong_dimensions",
+    "wrong_clock",
+    "wrong_origin",
+    "incomplete_moments",
+    "bad_moment_shape",
+    "bad_moment_dtype",
+    "negative_variance",
+    "nonfinite_moment",
+)
