+def _gc_membership(bank, label):
+    from townlet.exploration.rng_custody import process_rng_domain
+
+    domain = process_rng_domain()
+    with domain._lock:
+        members = {}
+        for participant, member in domain._members.items():
+            owner = member.owner()
+            members[id(participant)] = (id(owner), f"{type(owner).__module__}.{type(owner).__qualname__}", member.owner)
+        cohort = []
+        for record in bank._restore_tokens.values():
+            held = record[-1]
+            objects = [held.bank, *held.input_rngs, *held.owners.values()]
+            if held.shared is not None:
+                objects.append(held.shared)
+            if held.validation_rng is not None:
+                objects.append(held.validation_rng)
+            cohort.extend(id(value) for value in objects)
+        state = dict(
+            generation=domain._generation,
+            revision=domain._revision,
+            currency=domain._currency,
+            bank_participant=id(bank._rng_participant),
+            members=members,
+            cohort=cohort,
+            tokens={id(token): (id(record.participant), record.generation) for token, record in domain._tokens.items()},
+        )
+    print("GC_MEMBERSHIP", label, state, flush=True)
+    return state
+
