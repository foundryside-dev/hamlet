+def test_healthy_recurrent_direct_episode_and_sample() -> None:
+    owner = _sequence_direct()
+    batch = owner.sample_sequences(1, 2)
+    assert batch["observations"].shape == (1, 2, 1)
+    assert batch["mask"].tolist() == [[True, True]]
+
