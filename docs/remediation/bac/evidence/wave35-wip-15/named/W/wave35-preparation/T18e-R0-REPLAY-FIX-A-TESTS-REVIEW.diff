+def test_per_generator_staging_fault_preserves_full_live_state_and_healthy_use(monkeypatch: pytest.MonkeyPatch) -> None:
+    owner = _publication_owner("per")
+    assert isinstance(owner, PrioritizedReplayBuffer)
