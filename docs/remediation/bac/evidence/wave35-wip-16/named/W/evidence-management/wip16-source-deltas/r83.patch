+def _scratch_work(owner: _ObservedReplay, batch: Any, work: str) -> None:
+    before = owner.serialize()
+    if work == "priority-update":
+        selected = int(batch.unit_ids[0])
+        recorded = before["priority_state"]["domains"][0]
+        selected_slot = recorded["unit_ids"].tolist().index(selected)
+        assert float(recorded["priorities"][selected_slot]) != 7.0 + 1e-6
+        owner.update_priorities(batch.unit_ids, torch.full((1, 2), 7.0), loss_mask=batch.loss_mask)
+        after = owner.serialize()
+        updated = after["priority_state"]["domains"][0]
+        expected = recorded["priorities"].clone()
+        expected[selected_slot] = 7.0 + 1e-6
+        _same(updated["priorities"], expected)
+        _same(updated["unit_ids"], recorded["unit_ids"])
+        _same(updated["window_keys"], recorded["window_keys"])
+        _same(after["episodes"], before["episodes"])
+        assert after["priority_state"]["max_priority"] == 7.0 + 1e-6
+    else:
+        assert work == "store-refresh"
+        _store(owner, width=1, offset=20.0)
+        after = owner.serialize()
+        assert owner.num_transitions == before["num_transitions"] + 3
+        _same(after["episodes"][:-1], before["episodes"])
+        appended = after["episodes"][-1]
+        assert appended["observations"].tolist() == [[21.0], [22.0], [23.0]]
+        assert appended["next_observations"].tolist() == [[22.0], [23.0], [24.0]]
+        assert appended["rewards"].tolist() == [21.0, 22.0, 23.0]
+        assert appended["actions"].tolist() == [0, 1, 0]
+        assert appended["dones"].tolist() == [False, False, True]
+        assert appended["next_action_masks"].tolist() == [[True, True], [True, True], [True, True]]
+        assert appended["legality_recorded"].tolist() == [True, True, True]
+        assert appended["episode_id"] == 1 and appended["transition_ids"].tolist() == [3, 4, 5]
+        domain = after["priority_state"]["domains"][0]
+        assert domain["sequence_length"] == 2
+        assert domain["window_keys"].tolist() == [[0, 0, 1], [0, 1, 2], [1, 3, 4], [1, 4, 5]]
+        assert domain["unit_ids"].tolist() == [0, 1, 2, 3]
+
