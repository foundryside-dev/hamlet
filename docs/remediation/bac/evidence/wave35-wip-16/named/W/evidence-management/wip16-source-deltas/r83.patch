+@pytest.mark.parametrize("profile", ["uniform", "priority"])
+@pytest.mark.parametrize("damage", ["nonfinite", "successor", "transition-id", "fragment-offset", "extra-row-key"])
+def test_recurrent_mutated_captured_dto_cannot_gain_authority(profile: str, damage: str) -> None:
+    """B1 intended RED: owning mutable bytes must not substitute for validation."""
+    owner = _owner(profile)
+    validated = owner.validate_serialized(owner.serialize(), expected_obs_dim=1)
+    episode = validated.episodes[0]
+    if damage == "nonfinite":
+        episode["rewards"][0] = float("nan")
+    elif damage == "successor":
+        episode["next_action_masks"][0].fill_(False)
+    elif damage == "transition-id":
+        episode["transition_ids"][0] = -1
+    elif damage == "fragment-offset":
+        episode["start_offset"] = -1
+    else:
+        episode["unexpected"] = 1
+    before = _live(owner)
+    with pytest.raises(ValueError):
+        owner.materialize_validated(validated, lineage=None)
+    _same(before, _live(owner))
+
