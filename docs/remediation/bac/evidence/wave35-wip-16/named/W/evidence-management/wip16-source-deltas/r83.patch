+@pytest.mark.parametrize("profile", ["uniform", "priority", "inspection"])
+def test_recurrent_validated_width_rechecks_current_destination(profile: str) -> None:
+    """Already-correct guard: stale target geometry cannot gain fresh authority."""
+    owner = _owner(profile)
+    saved = owner.serialize()
+    validated = owner.validate_serialized(saved, expected_obs_dim=1)
+    owner.clear()
+    if profile == "inspection":
+        # The preserved archive independently fixes width1: use its real refusal.
+        before = _live(owner)
+        with pytest.raises(ValueError, match="[Ww]idth|obs_dim"):
+            owner.prepare_serialized(saved, expected_obs_dim=2, lineage=None)
+        _same(before, _live(owner))
+        fresh = owner.materialize_validated(validated, lineage=None)
+        owner.load_prepared(fresh, lineage=None)
+        _same(saved, owner.serialize())
+        return
+    _store(owner, width=2, offset=20.0)
+    before = _live(owner)
+    with pytest.raises(ValueError, match="[Ww]idth|obs_dim"):
+        owner.prepare_serialized(saved, expected_obs_dim=2, lineage=None)
+    _same(before, _live(owner))
+    with pytest.raises(ValueError, match="[Ww]idth|obs_dim"):
+        owner.materialize_validated(validated, lineage=None)
+    _same(before, _live(owner))
+
