+def test_recurrent_partial_publication_quarantines_all_managed_routes() -> None:
+    owner = _owner("priority")
+    source = _owner("priority")
+    _store(source, width=1, offset=40.0)
+    incoming = source.serialize()
+    before = _live(owner)
+    candidate = owner.prepare_serialized(incoming, expected_obs_dim=1, lineage=None)
+    owner._fail_publication = True
+    with pytest.raises(RuntimeError, match="assignment fault after episodes publication"):
