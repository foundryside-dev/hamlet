+def _observe_scratch(owner: _ObservedReplay, batch: Any, work: str) -> None:
+    """A transparent seam observes the real selected sampler and scratch draw."""
+    ambient = _ambient()
+    before = owner.serialize()["priority_state"]["rng"]
+    assert owner._priority is not None
+    persistent = owner._priority.rng
+    original = recurrent.per_sampling.sample_units
+    observations: list[tuple[Any, Any]] = []
+
+    def observed(priorities: Any, *, alpha: float, beta: float, batch_size: int, mode: str, rng: Any) -> Any:
+        assert rng is not persistent and beta == 0.0 and batch_size == 1
+        initial = copy.deepcopy(rng.bit_generator.state)
+        receipt = original(priorities, alpha=alpha, beta=beta, batch_size=batch_size, mode=mode, rng=rng)
+        final = copy.deepcopy(rng.bit_generator.state)
+        assert pickle.dumps(initial) != pickle.dumps(final), "real support sampling must advance the disposable engine"
+        assert receipt.indices.shape == (1,)
+        observations.append((initial, final))
+        return receipt
+
+    with pytest.MonkeyPatch.context() as observe:
+        observe.setattr(recurrent.per_sampling, "sample_units", observed)
+        _scratch_work(owner, batch, work)
+    assert observations, "actual support sampling was not reached"
+    assert owner._priority.rng is persistent
+    _same(before, owner.serialize()["priority_state"]["rng"])
+    _same(ambient, _ambient())
+
+
+@pytest.mark.parametrize("family", _FAMILIES)
+@pytest.mark.parametrize("mode", [_SUCCESSIVE, _INDEPENDENT], ids=["successive", "independent"])
+@pytest.mark.parametrize("work", ["priority-update", "store-refresh"])
+def test_recurrent_support_draw_preserves_ambient_and_persistent_stream(family: str, mode: str, work: str) -> None:
+    """Deleting support or advancing persistent/ambient RNG must break this control."""
+    owner = _priority_owner(family, mode)
+    control = _priority_owner(family, mode)
+    batch = owner.sample_batch(_request(mode), lineage=None)
+    comparison = control.sample_batch(_request(mode), lineage=None)
+    retained._assert_same_selected_batch(batch, comparison)
+    _observe_scratch(owner, batch, work)
+    # Equivalent real work retains exact persistent continuation, independently
+    # of the observation wrapper; compare next real selections and complete RNG.
+    _scratch_work(control, comparison, work)
+    first = owner.sample_batch(_request(mode), lineage=None)
+    second = control.sample_batch(_request(mode), lineage=None)
+    retained._assert_same_selected_batch(first, second)
+    _same(owner.serialize()["priority_state"]["rng"], control.serialize()["priority_state"]["rng"])
+
+
+_CHILD_ROLE = "recurrent_replay_poison"
+_CHILD_MESSAGE = "recurrent replay scratch poison fail closed"
+_CHILD_IMPORTS = (
+    "townlet.training.sequential_replay_buffer",
+    "townlet.training.replay_contract",
+    "townlet.exploration.rng_custody",
+    "test_recurrent_replay_rng_custody",
+    "test_replay_rng_custody",
+)
+
+
+def _scratch_poison_child(queue: Any) -> None:
+    qualified = bootstrap._child_identity(_CHILD_ROLE)
+    if qualified:
+        path = Path(os.environ["BAC_QUAL_OUTPUT"]) / f"spawn-identity-{_CHILD_ROLE}.json"
+        identity = json.loads(path.read_text())
+        identity["ppid"] = os.getppid()
+        imports = {}
+        for name in _CHILD_IMPORTS:
+            location = importlib.import_module(name).__file__
+            assert location is not None
+            imports[name] = str(Path(location).resolve())
+        identity["replay_imports"] = imports
+        path.write_text(json.dumps(identity, sort_keys=True))
+    owner = _owner("priority")
+    batch = owner.sample_batch(_request(_SUCCESSIVE), lineage=None)
+    saved = owner.serialize()
+    ambient = _ambient()
+    domain = process_rng_domain()
+    with domain.operation(participant=owner.rng_participant, operation_kind="prepare", lineage=None) as lease:
+        candidate = owner.prepare_serialized(saved, expected_obs_dim=1, lineage=lease)
+        domain.poison(operation=lease, error=RuntimeError("recurrent scratch poison control"))
+    for work in ("priority-update", "store-refresh"):
+        _observe_scratch(owner, batch, work)
+        before = _live(owner)
+        for operation in (
+            lambda: owner.sample_batch(_request(_SUCCESSIVE), lineage=None),
+            lambda: owner.sample_sequences(1, 2, lineage=None),
+            lambda: owner.prepare_serialized(saved, expected_obs_dim=1, lineage=None),
+            lambda: owner.load_prepared(candidate, lineage=None),
+        ):
+            with pytest.raises(RuntimeError, match="Ambient RNG domain is poisoned after failed restoration"):
+                operation()
+            _same(before, _live(owner))
+    owner.clear()
+    cleared = _live(owner)
+    assert owner.num_transitions == 0 and domain.status()[2]
+    for operation in (
+        lambda: owner.sample_batch(_request(_SUCCESSIVE), lineage=None),
+        lambda: owner.prepare_serialized(saved, expected_obs_dim=1, lineage=None),
+        lambda: owner.load_prepared(candidate, lineage=None),
+    ):
+        with pytest.raises(RuntimeError, match="Ambient RNG domain is poisoned after failed restoration"):
+            operation()
+        _same(cleared, _live(owner))
+    _same(ambient, _ambient())
+    queue.put((_CHILD_MESSAGE, os.getpid(), os.getppid(), qualified))
+
+
+def test_isolated_recurrent_scratch_work_cannot_heal_common_poison() -> None:
+    """Only a fresh actual child is poisoned; root qualifies its identity record."""
+    qualified = bootstrap._qualification_active()
+    parent_pid = os.getpid()
+    ambient = _ambient()
+    context = multiprocessing.get_context("spawn")
+    queue = context.Queue()
+    process = context.Process(target=_scratch_poison_child, args=(queue,), name=_CHILD_ROLE)
+    started = False
+    try:
+        process.start()
+        started = True
+        process.join(90)
+        assert not process.is_alive() and process.exitcode == 0
+        message, queued_pid, child_ppid, child_qualified = queue.get(timeout=5)
+        assert message == _CHILD_MESSAGE
+        assert queued_pid == process.pid and child_ppid == parent_pid
+        assert child_qualified is qualified
+        if qualified:
+            observation = {
+                "process_pid": process.pid,
+                "queued_pid": queued_pid,
+                "exitcode": process.exitcode,
+                "qualified": qualified,
+                "message": message,
+                "manifest_sha256": hashlib.sha256(Path(os.environ["BAC_QUAL_MANIFEST"]).read_bytes()).hexdigest(),
+                "parent_pid": parent_pid,
+            }
+            destination = Path(os.environ["BAC_QUAL_OUTPUT"]) / f"spawn-observation-{_CHILD_ROLE}.json"
+            with destination.open("x") as output:
+                json.dump(observation, output, sort_keys=True)
+    finally:
+        if started and process.is_alive():
+            process.terminate()
+            process.join(10)
+        survived = started and process.is_alive()
+        queue.close()
+        queue.join_thread()
+        if not survived:
+            process.close()
+        if survived:
+            raise AssertionError("recurrent replay child survived bounded cleanup")
+    assert not process_rng_domain().status()[2]
+    _same(ambient, _ambient())
