+    assert owner.next_episode_id == before["next_episode_id"] == 1
+    assert incoming["next_episode_id"] == 2
+    for operation in (
+        lambda: owner.sample_batch(_request(_SUCCESSIVE), lineage=None),
+        lambda: owner.sample_sequences(1, 2, lineage=None),
+        lambda: owner.prepare_serialized(incoming, expected_obs_dim=1, lineage=None),
+        lambda: owner.load_prepared(candidate, lineage=None),
+        owner.clear,
+        owner.serialize,
+    ):
+        with pytest.raises(RuntimeError, match="quarantined after uncertain publication"):
+            operation()
