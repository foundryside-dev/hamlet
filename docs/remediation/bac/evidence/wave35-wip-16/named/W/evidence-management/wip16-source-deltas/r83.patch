+@pytest.mark.parametrize("stage", ["episode-copy", "archive-merge", "policy-copy", "priority-copy"])
+def test_recurrent_staging_fault_preserves_live_state_and_healthy_use(stage: str, monkeypatch: pytest.MonkeyPatch) -> None:
+    owner = _owner("priority")
+    if stage == "archive-merge":
+        _add_archive(owner)
+    owner.sample_batch(_request(_SUCCESSIVE), lineage=None)
+    incoming = _incoming(owner)
+    candidate = owner.prepare_serialized(incoming, expected_obs_dim=1, lineage=None)
+    material = owner._retained_material
+    before = _live(owner)
+    staged: list[Any] = []
+    original_fragment, original_merge = owner._own_fragment, owner._merge_archives
+    original_priority = owner._restore_priority
+    policy_type = type(material.replay_options)
+    original_policy = policy_type.model_copy
+
+    def fragment_then_fail(episode: Any, *, device: torch.device) -> Any:
+        owned = original_fragment(episode, device=device)
+        if episode is material.episodes[0]:
+            assert owned is not episode
+            _same(owned, episode)
+            staged.append(owned)
+            raise RuntimeError("recurrent staged episode-copy fault")
+        return owned
+
+    def merge_then_fail(archives: Any, *, expected_obs_dim: int | None) -> Any:
+        owned = original_merge(archives, expected_obs_dim=expected_obs_dim)
+        assert len(owned) == 1
+        _same(owned[0].original_state, archives[0].original_state)
+        staged.append(owned)
+        raise RuntimeError("recurrent staged archive-merge fault")
+
+    def policy_then_fail(policy: Any, *args: Any, **kwargs: Any) -> Any:
+        owned = original_policy(policy, *args, **kwargs)
+        if policy is material.replay_options:
+            assert owned is not policy
+            _same(owned.model_dump(), policy.model_dump())
+            staged.append(owned)
+            raise RuntimeError("recurrent staged policy-copy fault")
+        return owned
+
+    def priority_then_fail(priority: Any) -> Any:
+        owned = original_priority(priority)
+        assert owned.rng is not priority.rng
+        _same(owner._encode_rng(owned.rng), owner._encode_rng(priority.rng))
+        assert all(new.priorities is not old.priorities for new, old in zip(owned.domains, priority.domains, strict=True))
+        staged.append(owned)
+        raise RuntimeError("recurrent staged priority-copy fault")
+
+    with monkeypatch.context() as fault:
+        if stage == "episode-copy":
+            fault.setattr(owner, "_own_fragment", fragment_then_fail)
+        elif stage == "archive-merge":
+            fault.setattr(owner, "_merge_archives", merge_then_fail)
+        elif stage == "policy-copy":
+            fault.setattr(policy_type, "model_copy", policy_then_fail)
+        else:
+            fault.setattr(owner, "_restore_priority", priority_then_fail)
+        with pytest.raises(RuntimeError, match=f"recurrent staged {stage} fault"):
+            owner.load_prepared(candidate, lineage=None)
+    assert len(staged) == 1, "failure must follow the actual selected staging operation"
+    _same(before, _live(owner))
+    fresh = owner.prepare_serialized(incoming, expected_obs_dim=1, lineage=None)
+    owner.load_prepared(fresh, lineage=None)
+    _same(incoming, owner.serialize())
+    assert owner.sample_batch(_request(_SUCCESSIVE), lineage=None).observations.shape == (1, 2, 1)
+
