+@pytest.mark.parametrize("interference", ["sibling-sample", "owner-storage"])
+def test_recurrent_nested_preparation_refuses_intervening_work(profile: str, interference: str) -> None:
+    owner, sibling = _owner(profile), _owner("uniform")
+    peer, participant = retained._peer()
+    with process_rng_domain().operation(participant=participant, operation_kind="hold", lineage=None) as lease:
+        candidate = owner.prepare_serialized(_incoming(owner), expected_obs_dim=1, lineage=lease)
+        if interference == "sibling-sample":
+            ambient = _ambient()
+            assert sibling.sample_batch(_request(_SUCCESSIVE), lineage=lease).observations.shape == (1, 2, 1)
+            assert random.getstate() != ambient[0]
+        else:
+            _store(owner, width=1, offset=20.0)
+        before = _live(owner)
+        with pytest.raises(ValueError, match="[Pp]repar|[Dd]estination|[Ss]tale|[Cc]urrency"):
+            owner.load_prepared(candidate, lineage=lease)
+        _same(before, _live(owner))
