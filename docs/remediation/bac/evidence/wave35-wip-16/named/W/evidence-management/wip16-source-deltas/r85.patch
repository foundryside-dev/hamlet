+@pytest.mark.parametrize("interference", ["sibling-sample", "owner-storage"])
+def test_recurrent_nested_preparation_refuses_intervening_work(profile: str, interference: str) -> None:
+    owner, sibling = _owner(profile), _owner("uniform")
