+def _observe_scratch(owner: _ObservedReplay, batch: Any, work: str) -> None:
+    """A transparent seam observes the real selected sampler and scratch draw."""
+    ambient = _ambient()
+    before = owner.serialize()["priority_state"]["rng"]
+    assert owner._priority is not None
+    persistent = owner._priority.rng
+    original = recurrent.per_sampling.sample_units
+    observations: list[tuple[Any, Any]] = []
+
+    def observed(priorities: Any, *, alpha: float, beta: float, batch_size: int, mode: str, rng: Any) -> Any:
+        assert rng is not persistent and beta == 0.0 and batch_size == 1
+        initial = copy.deepcopy(rng.bit_generator.state)
+        receipt = original(priorities, alpha=alpha, beta=beta, batch_size=batch_size, mode=mode, rng=rng)
+        final = copy.deepcopy(rng.bit_generator.state)
+        assert pickle.dumps(initial) != pickle.dumps(final), "real support sampling must advance the disposable engine"
+        assert receipt.indices.shape == (1,)
+        observations.append((initial, final))
+        return receipt
+
+    with pytest.MonkeyPatch.context() as observe:
+        observe.setattr(recurrent.per_sampling, "sample_units", observed)
+        _scratch_work(owner, batch, work)
+    assert observations, "actual support sampling was not reached"
+    assert owner._priority.rng is persistent
+    _same(before, owner.serialize()["priority_state"]["rng"])
+    _same(ambient, _ambient())
+
+
+@pytest.mark.parametrize("family", _FAMILIES)
+@pytest.mark.parametrize("mode", [_SUCCESSIVE, _INDEPENDENT], ids=["successive", "independent"])
+@pytest.mark.parametrize("work", ["priority-update", "store-refresh"])
+def test_recurrent_support_draw_preserves_ambient_and_persistent_stream(family: str, mode: str, work: str) -> None:
+    """Deleting support or advancing persistent/ambient RNG must break this control."""
+    owner = _priority_owner(family, mode)
+    control = _priority_owner(family, mode)
+    batch = owner.sample_batch(_request(mode), lineage=None)
+    comparison = control.sample_batch(_request(mode), lineage=None)
+    retained._assert_same_selected_batch(batch, comparison)
+    _observe_scratch(owner, batch, work)
+    # Equivalent real work retains exact persistent continuation, independently
+    # of the observation wrapper; compare next real selections and complete RNG.
+    _scratch_work(control, comparison, work)
+    first = owner.sample_batch(_request(mode), lineage=None)
+    second = control.sample_batch(_request(mode), lineage=None)
+    retained._assert_same_selected_batch(first, second)
+    _same(owner.serialize()["priority_state"]["rng"], control.serialize()["priority_state"]["rng"])
