+def test_recurrent_mutated_priority_dto_provenance_cannot_gain_authority() -> None:
+    """B1 intended RED: nested mutable priority metadata needs full revalidation."""
+    owner = _owner("priority")
+    owner.sample_batch(_request(_SUCCESSIVE), lineage=None)
+    validated = owner.validate_serialized(owner.serialize(), expected_obs_dim=1)
+    assert validated.priority is not None
+    validated.priority.initialization["kind"] = "unrecorded-provenance"
+    before = _live(owner)
+    with pytest.raises(ValueError):
+        owner.materialize_validated(validated, lineage=None)
+    _same(before, _live(owner))
+
