+def _scratch_poison_child(queue: Any) -> None:
+    qualified = bootstrap._child_identity(_CHILD_ROLE)
+    if qualified:
+        path = Path(os.environ["BAC_QUAL_OUTPUT"]) / f"spawn-identity-{_CHILD_ROLE}.json"
+        identity = json.loads(path.read_text())
+        identity["ppid"] = os.getppid()
+        imports = {}
+        for name in _CHILD_IMPORTS:
+            location = importlib.import_module(name).__file__
+            assert location is not None
+            imports[name] = str(Path(location).resolve())
+        identity["replay_imports"] = imports
+        path.write_text(json.dumps(identity, sort_keys=True))
+    owner = _owner("priority")
+    batch = owner.sample_batch(_request(_SUCCESSIVE), lineage=None)
+    saved = owner.serialize()
+    ambient = _ambient()
+    domain = process_rng_domain()
+    with domain.operation(participant=owner.rng_participant, operation_kind="prepare", lineage=None) as lease:
+        candidate = owner.prepare_serialized(saved, expected_obs_dim=1, lineage=lease)
+        domain.poison(operation=lease, error=RuntimeError("recurrent scratch poison control"))
+    for work in ("priority-update", "store-refresh"):
+        _observe_scratch(owner, batch, work)
+        before = _live(owner)
+        for operation in (
+            lambda: owner.sample_batch(_request(_SUCCESSIVE), lineage=None),
+            lambda: owner.sample_sequences(1, 2, lineage=None),
+            lambda: owner.prepare_serialized(saved, expected_obs_dim=1, lineage=None),
+            lambda: owner.load_prepared(candidate, lineage=None),
+        ):
+            with pytest.raises(RuntimeError, match="Ambient RNG domain is poisoned after failed restoration"):
+                operation()
+            _same(before, _live(owner))
+    owner.clear()
+    cleared = _live(owner)
+    assert owner.num_transitions == 0 and domain.status()[2]
+    for operation in (
+        lambda: owner.sample_batch(_request(_SUCCESSIVE), lineage=None),
+        lambda: owner.prepare_serialized(saved, expected_obs_dim=1, lineage=None),
+        lambda: owner.load_prepared(candidate, lineage=None),
+    ):
+        with pytest.raises(RuntimeError, match="Ambient RNG domain is poisoned after failed restoration"):
+            operation()
+        _same(cleared, _live(owner))
+    _same(ambient, _ambient())
+    queue.put((_CHILD_MESSAGE, os.getpid(), os.getppid(), qualified))
+
