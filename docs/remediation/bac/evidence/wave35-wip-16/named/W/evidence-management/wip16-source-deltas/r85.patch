+"""Recurrent DTO validity, real scratch sampling and publication controls.
+
+B1 malformed returned DTOs are intended causal RED on the frozen producer.
+Width/currentness, scratch preservation and staged publication are controls of
+existing behavior. Real sampling/storage/copying always precedes observations
+or selected fault injection; the parent process is never intentionally poisoned.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib
+import json
+import multiprocessing
+import os
+import pickle
+import random
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pytest
+import test_replay_rng_custody as retained
+import test_world_rng_bootstrap as bootstrap
+import torch
+
+from townlet.exploration.rng_custody import RNGOperation, process_rng_domain
+from townlet.training import sequential_replay_buffer as recurrent
+from townlet.training.replay_contract import PreparedReplay
+from townlet.training.sequential_replay_buffer import SequentialReplayBuffer
+
+_CPU = torch.device("cpu")
+_SUCCESSIVE = "successive_without_replacement"
+_INDEPENDENT = "independent_with_replacement"
+_FAMILIES = ("PCG64", "PCG64DXSM", "MT19937", "Philox", "SFC64")
+_same = retained._assert_same_transport
+_ambient = retained._ambient_cpu_state
+
+
+@pytest.fixture(autouse=True)
+def _restore_ambient() -> Any:
+    before = _ambient()
+    try:
+        yield
+    finally:
+        random.setstate(before[0])
+        np.random.set_state(before[1])
+        torch.set_rng_state(before[2])
+
+
+class _ObservedReplay(SequentialReplayBuffer):
+    """Observe actual issuer material; fail only a selected live assignment."""
+
+    _retained_material: Any
+
+    def _issue_replay(self, payload: object, lease: RNGOperation) -> PreparedReplay:
+        self._retained_material = payload
+        return super()._issue_replay(payload, lease)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        if name == "_configured" and getattr(self, "_fail_publication", False):
+            raise RuntimeError("recurrent assignment fault after episodes publication")
+        super().__setattr__(name, value)
+
+
+def _store(owner: SequentialReplayBuffer, *, width: int, offset: float) -> None:
+    episode = retained._episode()
+    for name in ("observations", "next_observations"):
+        episode[name] = episode[name].repeat(1, width) + offset
+    episode["rewards"] = episode["rewards"] + offset
+    if owner._configured:
+        owner.store_captured_episode(
+            episode,
+            next_action_masks=torch.ones((3, 2), dtype=torch.bool),
+            legality_recorded=torch.ones(3, dtype=torch.bool),
+        )
+    else:
+        owner.store_episode(episode)
+
+
+def _priority_owner(family: str, mode: str) -> _ObservedReplay:
+    owner = _ObservedReplay.for_prioritized_replay(
+        8,
+        _CPU,
+        options=retained._options().model_copy(update={"sampling_mode": mode}),
+        action_dim=2,
+        legality_mode="captured",
+        alpha=0.6,
+        beta=0.4,
+        beta_annealing=False,
+        beta_vector_tick_horizon=100,
+        current_vector_tick=0,
+        rng=np.random.Generator(getattr(np.random, family)(911)),
+        origin="authored",
+    )
+    assert isinstance(owner, _ObservedReplay)
+    _store(owner, width=1, offset=0.0)
+    return owner
+
+
+def _owner(profile: str) -> _ObservedReplay:
+    if profile == "priority":
+        return _priority_owner("PCG64", _SUCCESSIVE)
+    if profile == "uniform":
+        owner = _ObservedReplay.for_replay(8, _CPU, options=retained._options(), action_dim=2, legality_mode="captured")
+        assert isinstance(owner, _ObservedReplay)
+    else:
+        assert profile in ("legacy", "inspection")
+        owner = _ObservedReplay(8, _CPU)
+    _store(owner, width=1, offset=0.0)
+    if profile == "inspection":
+        owner.load_from_serialized(owner.serialize(), lineage=None)
+        assert len(owner.historical_archives) == 1
+        _store(owner, width=1, offset=10.0)
+    return owner
+
+
+def _request(mode: str) -> Any:
+    return recurrent.ReplayRequest(1, 2, 1, mode, "fixed_full", "window_mean")
+
+
+def _live(owner: SequentialReplayBuffer) -> dict[str, Any]:
+    """Complete data state, including physical rows absent from archival transport.
+
+    Revision/currency may change conservatively during a refused operation;
+    neither is replay data, so they are intentionally outside this comparison.
+    """
+    return {
+        "transport": owner.serialize(),
+        "episodes": copy.deepcopy(list(owner.episodes)),
+        "capacity": owner.capacity,
+        "device": owner.device,
+        "count": owner.num_transitions,
+        "configured": owner._configured,
+        "action_dim": owner.action_dim,
+        "legality_mode": owner.legality_mode,
+        "options": None if owner.replay_options is None else owner.replay_options.model_dump(),
+        "next_episode_id": owner.next_episode_id,
+        "next_transition_id": owner.next_transition_id,
+        "healthy": owner._replay_healthy,
+    }
+
+
+def _incoming(owner: SequentialReplayBuffer) -> dict[str, Any]:
+    saved = owner.serialize()
+    for episode in saved["episodes"]:
+        for name in ("observations", "next_observations", "rewards"):
+            episode[name].add_(40.0)
+    return saved
+
