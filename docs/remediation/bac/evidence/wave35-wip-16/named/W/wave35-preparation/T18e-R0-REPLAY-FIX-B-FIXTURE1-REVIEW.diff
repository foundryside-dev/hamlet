+def test_recurrent_captured6_dto_adapts_to_prioritized_destination() -> None:
+    """Reconstruction must retain real captured6 active rows and priority custody."""
+    source, owner = _owner("uniform"), _owner("priority")
+    owner.sample_batch(_request(_SUCCESSIVE), lineage=None)
+    before = owner.serialize()["priority_state"]
+    incoming = _incoming(source)
+    assert incoming["format_version"] == 6 and "priority_state" not in incoming
+    validated = owner.validate_serialized(incoming, expected_obs_dim=1)
+    candidate = owner.materialize_validated(validated, lineage=None)
+    owner.load_prepared(candidate, lineage=None)
+    installed = owner.serialize()
+    assert installed["format_version"] == 7
+    for name, value in incoming.items():
+        if name != "format_version":
+            _same(value, installed[name])
+    priority = installed["priority_state"]
+    assert priority["initialization"] == {
+        "kind": "captured6_active_adapter",
+        "source_replay_kind": "sequential",
+        "source_format_version": 6,
+    }
+    for name in ("alpha", "beta_initial", "beta", "beta_annealing", "beta_vector_tick_horizon", "current_vector_tick", "origin", "rng"):
+        _same(before[name], priority[name])
+    assert priority["max_priority"] == 1.0 and priority["domains"] == []
+    ambient = _ambient()
+    sampled = owner.sample_batch(_request(_SUCCESSIVE), lineage=None)
+    assert sampled.observations.tolist() in ([[[41.0], [42.0]]], [[[42.0], [43.0]]])
+    assert sampled.legality_recorded.tolist() == [[True, True]]
+    assert sampled.sampling.population_size == 2
+    assert pickle.dumps(owner.serialize()["priority_state"]["rng"]) != pickle.dumps(priority["rng"])
+    _same(ambient, _ambient())
+
+
