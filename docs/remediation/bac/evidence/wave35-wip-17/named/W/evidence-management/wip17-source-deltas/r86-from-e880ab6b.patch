+class Owner:
+    def __init__(self) -> None:
+        self.lock = threading.RLock()
+        self.revision = 0
+        self.quarantined = False
+
+
+class OtherOwner:
+    pass
+
+
+class ChildOwner(Owner):
+    pass
+
