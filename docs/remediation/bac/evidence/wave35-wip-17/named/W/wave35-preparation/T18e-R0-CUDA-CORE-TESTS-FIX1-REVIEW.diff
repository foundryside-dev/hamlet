+def guard_state(domain: Any) -> tuple[Any, ...]:
+    return (
+        domain._pid,
+        domain._generation,
+        domain._revision,
+        domain._currency,
+        domain._ambient_revision,
+        id(domain._poison),
+        tuple(id(key) for key in domain._members),
+        tuple(id(key) for key in domain._operations),
+        tuple(id(key) for key in domain._tokens),
+        domain._cuda_ready,
+    )
+
