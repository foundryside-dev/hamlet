          "command": [
            "/workspace/hamlet/.venv/bin/python",
            "-m",
            "mypy",
            "--follow-imports=silent",
            "-c",
            "from typing import assert_type\nimport torch\nfrom townlet.exploration.rng_custody import AmbientRNGDomain, RNGParticipant, RNGOperation, RNGAdmission, LocalCUDAContract, LocalCUDAGate\n\ndef check_public(domain: AmbientRNGDomain, participant: RNGParticipant, lineage: RNGOperation | None, contract: LocalCUDAContract, device: torch.device, devices: tuple[int, ...], error: BaseException) -> None:\n    with domain.operation(participant=participant, operation_kind=\"ordinary\", lineage=lineage) as operation:\n        assert_type(operation, RNGOperation)\n    with domain.device_operation(participant=participant, operation_kind=\"ordinary\", lineage=lineage, cuda_devices=devices) as operation:\n        assert_type(operation, RNGOperation)\n    with domain.admission(lineage=lineage) as admission:\n        assert_type(admission, RNGAdmission)\n        assert_type(admission.resolve_cuda(device), int)\n        assert_type(admission.enroll(participant=participant, cuda_devices=devices), None)\n        assert_type(admission.report_failure(error=error), None)\n    with domain.local_cuda_access(participant=participant, contract=contract) as local:\n        assert_type(local, LocalCUDAGate)\n        assert_type(local.resolve_cuda(device=device), int)\n        with local.complete(cuda_devices=devices) as completed:\n            assert_type(completed, None)\n        assert_type(local.completion_failed(), bool)\n        assert_type(local.report_failure(error=error), None)\n"
          ],
          "log": "/workspace/bac-review-2026-11-01/qualification/wave35-r88-types/public-types.log",
