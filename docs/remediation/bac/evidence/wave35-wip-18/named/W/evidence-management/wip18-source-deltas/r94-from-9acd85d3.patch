+        _assert_tree_equal(owner.serialize(), state)
+        fresh = owner.prepare_serialized(state, expected_obs_dim=2, lineage=parent)
+        owner.load_prepared(fresh, lineage=parent)
+    _assert_tree_equal(owner.serialize(), state)
