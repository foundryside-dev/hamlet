+_PRODUCER_ROLE = "cuda_producer_poison"
+_PRODUCER_CASES = tuple(
+    f"{family}_{schedule}"
+    for family in ("flat", "per")
+    for schedule in ("local_single", "local_distinct", "local_same", "admitted_single", "admitted_same")
