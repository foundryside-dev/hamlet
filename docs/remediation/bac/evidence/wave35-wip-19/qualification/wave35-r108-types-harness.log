{"name": "public-types", "exit_code": 0, "seconds": 1.5615246295928955, "command": ["/workspace/hamlet/.venv/bin/python", "-m", "mypy", "--follow-imports=silent", "-c", "from typing import assert_type, Literal\nfrom contextlib import AbstractContextManager\nimport torch\nfrom townlet.exploration.rng_custody import AmbientRNGDomain, RNGParticipant, RNGOperation, RNGAdmission, RNGDeviceInvocation, LocalCUDAContract, LocalCUDAGate\n\ndef check_public(domain: AmbientRNGDomain, participant: RNGParticipant, lineage: RNGOperation | None, contract: LocalCUDAContract, device: torch.device, devices: tuple[int, ...], error: BaseException) -> None:\n    with domain.operation(participant=participant, operation_kind=\"ordinary\", lineage=lineage) as operation:\n        assert_type(operation, RNGOperation)\n    with domain.device_operation(participant=participant, operation_kind=\"ordinary\", lineage=lineage, cuda_devices=devices) as operation:\n        assert_type(operation, RNGOperation)\n    with domain.admission(lineage=lineage) as admission:\n        assert_type(admission, RNGAdmission)\n        assert_type(admission.resolve_cuda(device), int)\n        assert_type(admission.enroll(participant=participant, cuda_devices=devices), None)\n        assert_type(admission.report_failure(error=error), None)\n    with domain.local_cuda_access(participant=participant, contract=contract) as local:\n        assert_type(local, LocalCUDAGate)\n        assert_type(local.resolve_cuda(device=device), int)\n        with local.complete(cuda_devices=devices) as completed:\n            assert_type(completed, None)\n        assert_type(local.completion_failed(), bool)\n        assert_type(local.report_failure(error=error), None)\n    invocation = domain.device_invocation(participant=participant, operation_kind=\"ordinary\", lineage=lineage, cuda_devices=devices)\n    assert_type(invocation, RNGDeviceInvocation)\n    context: AbstractContextManager[RNGOperation] = invocation\n    with context as invoked_operation:\n        assert_type(invoked_operation, RNGOperation)\n    assert_type(invocation.completion_failed(), bool)\n    assert_type(invocation.__exit__(None, None, None), Literal[False])\n"], "log": "/workspace/bac-review-2026-11-01/qualification/wave35-r108-types/public-types.log", "sha256": "5d4b6d285b77932e3d08212c3b4974d0a803f98ec60408ac6ccf6a063fa6c19e", "candidate_tree": "fa1c6804fcff475f5652e5f5f357468e2d931c0d", "base_commit": "df8dcebc90d8faec3da82f2eb036c24fcc2eb8e9", "manifest_sha256": "27b28f930659b690c55db0a0e4a2edc97155210ce0c9bf1f0e38738e4f85bdce", "harness_sha256": "180558c22da088a57326aa9251fbb64761e2788f18cb982532525b84b571f791"}
