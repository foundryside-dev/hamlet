    @pytest.mark.parametrize("mutation", ["missing-end", "wrong-pid", "wrong-start", "wrong-parent", "wrong-env", "unexpected-import", "false-work"])
    def test_process_lifecycle_mutations(evidence, mutation):
        end = json.loads(Path(evidence.processes[1]["path"]).read_text())
        if mutation == "missing-end":
            evidence.result["process_records"] = evidence.processes[:1]
        else:
            if mutation == "wrong-pid": end["identity"]["pid"] += 1
            if mutation == "wrong-start": end["identity"]["start_identity"] = "reused"
            if mutation == "wrong-parent": end["identity"]["ppid"] = 999
            if mutation == "wrong-env": end["environment"] = {**end["environment"], "UNSEALED": "1"}
            if mutation == "unexpected-import": end["imports"] = [dict(name="foreign", reference=evidence.policy_ref)]
            if mutation == "false-work": end["torch_observation"] = "work"
            evidence.result["process_records"][1] = write(Path(evidence.processes[1]["path"]), end)
        evidence.seal()
        with pytest.raises(ValueError):
>           evidence.verify()

