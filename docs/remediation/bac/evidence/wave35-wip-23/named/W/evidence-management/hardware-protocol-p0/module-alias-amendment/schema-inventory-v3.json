  "descriptor_grammar": {
    "object": "exact keys, all required, recursively validate",
    "enum": "type and value equal; bool is not int",
    "list": "exact list; descriptor is [list,item,min_length]",
    "nullable": "only explicit nullable permits null",
    "fact": "exact state,value,reason,provenance; measured typed value + empty reason; other states null + nonempty reason; provenance reference mandatory",
    "observed": "exact state,value,reason; measured typed value + empty reason, or unavailable null + nonempty reason",
    "primitives": {
      "int": "exact Python int",
      "uint": "exact int >= 0",
      "positive-int": "exact int >= 1",
      "number": "exact int/float, finite, 0..maximum IEEE754 float",
      "bool": "exact bool",
      "string": "exact str without NUL; empty allowed",
