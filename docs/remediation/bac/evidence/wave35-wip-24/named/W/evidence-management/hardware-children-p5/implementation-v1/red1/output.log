    @pytest.mark.parametrize('mutation',['extra','missing','pid','ppid','exit_bool','debug','role','phase','cleanup','source','rng'])
    def test_resealed_owner_mutations(mutation):
        b=Bundle('flat_local_distinct' if mutation=='cleanup' else 'replay_poison');p=b.named['payload'];c=b.named.get('child-result')
        if mutation=='extra':p['extra']=True
        elif mutation=='missing':del p['acknowledgement']
        elif mutation=='pid':p['process_pid']=999
        elif mutation=='ppid':p['acknowledgement']['ppid']=999
        elif mutation=='exit_bool':p['exitcode']=False
        elif mutation=='debug':c['python_assertions_enabled']=False
        elif mutation=='role':p['role']='foreign'
        elif mutation=='phase':b.named['completion']['outcomes'][0]['teardown']='failed'
        elif mutation=='cleanup':p['cleanup']['process_closed']=False
        elif mutation=='source':p['assertion_source']=OPAQUE
        elif mutation=='rng':p['parent_rng_assertion']['channels'].append('cuda')
