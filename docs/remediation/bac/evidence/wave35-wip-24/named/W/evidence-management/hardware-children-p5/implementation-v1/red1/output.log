        elif mutation=='bool':rows[0]['entry_ns']=True
        elif mutation=='negative':rows[0]['entry_ns']=-1
        elif mutation=='payload':o['parent_custody']['terminal_payload']=b.payload
        elif mutation=='emission':rows[1]['emission']=rows[0]['emission']
        elif mutation=='identity':o['parent_custody']['child_identity']={**o['parent_custody']['child_identity'],'pid':999}
        elif mutation=='actions':del t['guard_results']['enroll']
        elif mutation=='wait':o['wait_status']=9
        elif mutation=='clock':b.named['admission-end']['identity']={**b.named['admission-end']['identity'],'boot_id':'other'}
        elif mutation=='missing_doc':b.items=[i for i in b.items if i[0]!='admission-end-emission']
